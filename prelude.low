;; GC state, read and written by runtime.c and runtime.s
(data scheme-mem 1 ((:c-name "scheme_mem")))
(data scheme-len 1 ((:c-name "scheme_len")))
(data scheme-cap 1 ((:c-name "scheme_cap")))
(data scheme-limit 1 ((:c-name "scheme_limit")))
(data spare-mem 1 ((:c-name "spare_mem")))
(data gc-count 1 ((:c-name "gc_count")))
(data gc-copied 1 ((:c-name "gc_copied")))
(data gc-max-live 1 ((:c-name "gc_max_live")))
(data gc-used-before 1 ((:c-name "gc_used_before")))
(data gc-stress 1 ((:c-name "gc_stress")))
(data gc-countdown 1 ((:c-name "gc_countdown")))


(def tag ((val x)) -> (raw) (:inline)
     (bit-and (as-raw x) (raw 7)))

(def untag ((val x)) -> (raw) (:inline)
     (bit-and (as-raw x) (raw -8)))

(def tag=? ((val x) (raw y)) -> (val) (:inline)
     (raw= (tag x) y))

(def global-ref ((raw i)) -> (val) (:inline)
     (as-val (load (address "scheme_globals") i)))

(def global-set! ((raw i) (val v)) -> () (:inline)
     (store (address "scheme_globals") i v))

(def pair? ((val x)) -> (val) (:public :inline)
     (tag=? x (raw 3)))

(def stdout () -> (raw) (:inline)
     (load (address "stdout") (raw 0)))

(def stderr () -> (raw) (:inline)
     (load (address "stderr") (raw 0)))

(def procedure-type () -> (raw) (:inline)
     (raw 336)) ; 42 << 3

(def fixnum? ((val x)) -> (val) (:inline)
     (tag=? x (raw 1)))

(def null? ((val x)) -> (val) (:public :inline)
     (raw= (as-raw x) (as-raw '())))

(def eq? ((val x) (val y)) -> (val) (:public :inline)
     (raw= (as-raw x) (as-raw y)))

;; Prints x to the C stream out
(def display ((raw out) (val x)) -> () (:native (:c-name "scheme_display"))
     (if (fixnum? x)
         (c-call fprintf out "%ld" (raw>> (as-raw x) (raw 3)))
         (if (tag=? x (raw 2))
             (c-call fputs
                     (if (eq? x #f)
                         "#f"
                         (if (eq? x #t)
                             "#t"
                             (if (null? x)
                                 "()"
                                 (if (eq? x undef) "#<undef>" "#<err>"))))
                     out)
             (if (pair? x)
                 (display-pair out x)
                 (if (tag=? x (raw 0))
                     (display-pointer out x)
                     (c-call fputs "#<err>" out))))))

(def display-pair ((raw out) (val x)) -> () (:native)
     (c-call fputs "(" out)
     (display out (car x))
     (let more ((rest (cdr x)))
       (if (pair? rest)
           (begin
             (c-call fputs " " out)
             (display out (car rest))
             (more (cdr rest)))
           (begin
             (unless (null? rest)
               (c-call fputs " . " out)
               (display out rest))
             (c-call fputs ")" out)))))

(def display-pointer ((raw out) (val x)) -> () (:native)
     (if (raw= (as-raw x) (raw 0))
         (c-call fputs "#<null>" out)
         (if (raw= (load (as-raw x) (raw 0)) (procedure-type))
             (let ((name (load (as-raw x) (raw 3))))
               (if (raw= name (raw 0))
                   (c-call fputs "#<procedure>" out)
                   (c-call fprintf out "#<procedure %s>" name)))
             (c-call fputs "#<unknown ptr>" out))))

;; Prints fmt, a printf format using up to two arguments a and b, and exits;
;; for runtime.c, before the program runs or when it cannot go on
(def fatal ((raw fmt) (raw a) (raw b)) -> ! (:native (:c-name "scheme_fatal"))
     (c-call fflush (raw 0))
     (c-call fprintf (stderr) fmt a b)
     (c-call exit (raw 1)))

;; Prints "Error: msg: x" and exits
(def scheme-error ((raw msg) (val x)) -> ! (:native)
     (c-call fflush (raw 0))
     (c-call fprintf (stderr) "Error: %s: " msg)
     (display (stderr) x)
     (c-call fprintf (stderr) "\n")
     (c-call exit (raw 1)))

(def type-error ((raw x) (val y)) -> ! (:inline)
     (scheme-error x y))

(def arity-error ((val proc) (raw nargs)) -> ! (:native)
     (c-call fflush (raw 0))
     (c-call fprintf (stderr) "Error: procedure of arity %ld called with %ld arguments\n"
             (load (as-raw proc) (raw 1)) nargs)
     (c-call exit (raw 1)))

;; Checks that proc is a procedure taking nargs arguments
(def check-procedure ((val proc) (raw nargs)) -> () (:native)
     (unless (and (tag=? proc (raw 0))
                  (not (raw= (as-raw proc) (raw 0)))
                  (raw= (load (as-raw proc) (raw 0)) (procedure-type)))
       (type-error "expected procedure" proc))
     (unless (raw= (load (as-raw proc) (raw 1)) nargs)
       (arity-error proc nargs)))

(def car ((val x)) -> (val) (:public :inline)
     (unless (pair? x)
       (type-error "`car` expected a pair" x))
     (as-val (load (untag x) (raw 0))))

(def cdr ((val x)) -> (val) (:public :inline)
     (unless (pair? x)
       (type-error "`cdr` expected a pair" x))
     (as-val (load (untag x) (raw 1))))

(def cons ((val a) (val d)) -> (val) (:public :inline)
     (let ((p (alloc (raw 2))))
       (store p (raw 0) a)
       (store p (raw 1) d)
       (as-val (bit-or p (raw 3)))))

(def make-box ((val v)) -> (val) (:inline)
     (let ((b (alloc (raw 2))))
       (store b (raw 0) (raw 360)) ; box type, 45 << 3
       (store b (raw 1) v)
       (as-val b)))

(def box-ref ((val b)) -> (val) (:inline)
     (as-val (load (as-raw b) (raw 1))))

(def box-set! ((val b) (val v)) -> () (:inline)
     (store (as-raw b) (raw 1) v))

;; Capture i of the current closure: only valid inlined in its lifted function
(def closure-ref ((raw i)) -> (val) (:inline)
     (as-val (load (as-raw (self)) (raw+ i (raw 5)))))

;; A closure of proc, the template of a def with (:captures n), left to fill;
;; nothing may allocate before the captures are stored
(def alloc-closure ((raw proc)) -> (raw) (:inline)
     (let ((c (alloc (raw+ (load proc (raw 4)) (raw 5)))))
       (store c (raw 0) (load proc (raw 0)))
       (store c (raw 1) (load proc (raw 1)))
       (store c (raw 2) (load proc (raw 2)))
       (store c (raw 3) (load proc (raw 3)))
       (store c (raw 4) (load proc (raw 4)))
       c))

;; Sets capture i of the closure c from alloc-closure
(def closure-set! ((raw c) (raw i) (val v)) -> () (:inline)
     (store c (raw+ i (raw 5)) v))

(def check-fixnums ((val x) (val y) (raw msg)) -> () (:inline)
     (unless (fixnum? x)
       (type-error msg x))
     (unless (fixnum? y)
       (type-error msg y)))

;; Tagged fixnums: (n << 3) | 1, so the tags cancel out
(def + ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`+` expected an integer")
     (as-val (raw- (raw+ (as-raw x) (as-raw y)) (raw 1))))

(def - ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`-` expected an integer")
     (as-val (raw+ (raw- (as-raw x) (as-raw y)) (raw 1))))

(def * ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`*` expected an integer")
     (as-val (raw+ (raw* (raw- (as-raw x) (raw 1)) (raw>> (as-raw y) (raw 3)))
                   (raw 1))))

;; Comparing tagged fixnums compares their values
(def = ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`=` expected an integer")
     (raw= (as-raw x) (as-raw y)))

(def < ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`<` expected an integer")
     (raw< (as-raw x) (as-raw y)))

(def <= ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`<=` expected an integer")
     (raw<= (as-raw x) (as-raw y)))

(def > ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`>` expected an integer")
     (raw> (as-raw x) (as-raw y)))

(def >= ((val x) (val y)) -> (val) (:public :inline)
     (check-fixnums x y "`>=` expected an integer")
     (raw>= (as-raw x) (as-raw y)))

;; not is a low keyword, so the procedure is exported under that name
(def scm-not ((val x)) -> (val) (:public :inline (:as not))
     (not x))
