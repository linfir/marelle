#!/usr/bin/env -S scheme --libdirs compiler::build/chez --program

;; The compiler, run from the project root: every stage in one process.
;; ./schemec --lib DIR FILE...: the library, lib/*.ss in file name order, into DIR/lib.s and the
;; interface DIR/lib.scm
;; ./schemec < SOURCE > ASM: a program, against build/lib.scm
;; ./schemec --dump PASS < SOURCE: the program's IR after PASS (see dump-passes), instead of the asm

(import (chezscheme)
        (utils)
        (library)
        (asm))


;; Locals and the markers are gensyms: errors print their names
(print-gensym #f)


;; The forms of the files, in order
(define (library-forms files)
  (apply append (map (lambda (file) (with-input-from-file file read-all)) files)))


;; What thunk writes to the current output port, replacing the file, which Chez's
;; with-output-to-file does not
(define (write-file path thunk)
  (when (file-exists? path)
    (delete-file path))
  (with-output-to-file path thunk))


(let ((args (cdr (command-line))))
  (if (and (pair? args) (string=? (car args) "--lib"))
      (let-values (((entries interface) (compile-scheme-library (library-forms (cddr args)))))
        (write-file (string-append (cadr args) "/lib.scm")
                    (lambda ()
                      (for-each (lambda (x) (write x) (newline)) interface)))
        (write-file (string-append (cadr args) "/lib.s")
                    (lambda () (print-program (program-asm entries)))))
      (let ((pass (and (pair? args) (string=? (car args) "--dump") (pair? (cdr args))
                       (string->symbol (cadr args)))))
        (when (and pass (not (memq pass dump-passes)))
          (errorf 'schemec "unknown pass ~a, expected one of ~a" pass dump-passes))
        (parameterize ((dump-pass pass))
          (let* ((interface (with-input-from-file "build/lib.scm" read-all))
                 (asm (program-asm (compile-scheme-program interface (read-all)))))
            (unless pass
              (print-program asm)))))))


;; Compiled by itself, the value of the last form would be printed
(exit)
