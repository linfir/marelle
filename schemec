#!/usr/bin/env -S scheme --libdirs compiler::build/chez --program

;; The compiler: every stage in one process.
;; schemec --lib DIR FILE...: the library, lib/*.ss in file name order, into DIR/lib.s, the
;; image DIR/lib.img (layout.sls) and the interface DIR/lib.scm, with the image's stamp and
;; addresses
;; schemec -o FILE < SOURCE: a program, linked with the library into the executable FILE
;; (elf.sls); --map MAP also writes the address of every symbol to MAP
;; schemec -S < SOURCE > ASM: the program's asm, for as and ld with build/lib.o
;; schemec --dump PASS < SOURCE: the program's IR after PASS (see dump-passes); with --lib, the
;; library's, the files written too
;; --obj FILE: also with --lib, writes the ELF object of the asm (encode.sls, object.sls), for
;; asmcheck.py
;; --embed NAME=FILE, any number of times: the program's (embedded-file NAME) gives the bytes of
;; FILE
;; The library: the image and the interface embedded as lib.img and lib.scm, else build/lib.img
;; and build/lib.scm, from the project root; --libdir DIR forces DIR's files.

(import (chezscheme)
        (utils)
        (library)
        (asm)
        (encode)
        (object)
        (layout)
        (elf)
        (bytes)
        (host))


;; Locals and the markers are gensyms: errors print their names
(print-gensym #f)


;; The forms of the files, in order
(define (library-forms files)
  (apply append (map (lambda (file) (with-input-from-file file read-all)) files)))


;; What thunk writes to the current output port, replacing the file, which Chez's
;; with-output-to-file does not
(define (write-file path thunk)
  (when (file-exists? path)
    (delete-file path))
  (with-output-to-file path thunk))


;; Writes the bytevector bv to the file, replacing it
(define (write-binary-file path bv)
  (when (file-exists? path)
    (delete-file path))
  (let ((port (open-file-output-port path)))
    (put-bytevector port bv)
    (close-port port)))


;; The library's segments at the bases, scheme_program at the end of its data, and the text of the
;; interface with the address of each global symbol
(define (library-image asm interface)
  (let* ((unit (encode-asm asm))
         (p (place-unit unit segment-bases))
         (known (make-hashtable string-hash string=?)))
    (hashtable-set! known "scheme_program" (align-up (cadr (placement-ends p)) 8))
    (let ((linked (link-unit unit p known)))
      (values (linked-segments linked)
              (with-output-to-string
                (lambda ()
                  (for-each (lambda (x) (write x) (newline))
                            (append interface
                                    (map (lambda (s) `(symbol ,(car s) ,(cdr s)))
                                         (linked-globals linked))))))))))


;; The bytes of the file
(define (read-binary-file path)
  (let* ((port (open-file-input-port path))
         (bv (get-bytevector-all port)))
    (close-port port)
    (if (eof-object? bv) (make-bytevector 0) bv)))


;; The library's image and interface, which must come from the same build: those embedded,
;; unless dir is given, else dir's files, build's by default
(define (read-library dir)
  (let-values (((image interface)
                (let ((image (and (not dir) (embedded-file "lib.img")))
                      (text (and (not dir) (embedded-file "lib.scm"))))
                  (if (and image text)
                      (values image (with-input-from-string (utf8->string text) read-all))
                      (let ((dir (or dir "build")))
                        (values (read-binary-file (string-append dir "/lib.img"))
                                (with-input-from-file (string-append dir "/lib.scm") read-all)))))))
    (let ((image (read-image image)))
      (unless (eqv? (image-stamp image) (cadr (or (assq 'stamp interface) '(stamp #f))))
        (errorf 'schemec "the library's image and interface come from different builds"))
      (values image interface))))


;; The files of the --embed NAME=FILE options, ((name path bytes) ...)
(define (embedded-files args)
  (cond
   ((null? args) '())
   ((and (string=? (car args) "--embed") (pair? (cdr args)))
    (let* ((spec (cadr args))
           (i (let loop ((i 0))
                (cond
                 ((= i (string-length spec)) (errorf 'schemec "--embed expects NAME=FILE"))
                 ((char=? (string-ref spec i) #\=) i)
                 (else (loop (+ i 1))))))
           (path (substring spec (+ i 1) (string-length spec))))
      (cons (list (substring spec 0 i) path (read-binary-file path))
            (embedded-files (cddr args)))))
   (else (embedded-files (cdr args)))))


;; The address of the library's global symbol name
(define (library-symbol interface name)
  (let ((x (find (lambda (x) (and (eq? (car x) 'symbol) (string=? (cadr x) name))) interface)))
    (if x (caddr x) (errorf 'schemec "no symbol ~a in the library" name))))


;; The program's unit linked after the library
(define (link-program asm image interface)
  (let* ((unit (encode-asm asm))
         (p (place-unit unit (image-ends image)))
         (known (make-hashtable string-hash string=?)))
    (for-each (lambda (x)
                (when (eq? (car x) 'symbol)
                  (hashtable-set! known (cadr x) (caddr x))))
              interface)
    (let ((linked (link-unit unit p known)))
      (unless (eqv? (cdr (assoc "scheme_program" (linked-symbols linked)))
                    (align-up (cadr (image-ends image)) 8))
        (errorf 'schemec "scheme_program is not the program's first data"))
      linked)))


(define (hex n)
  (let loop ((n n) (digits '()))
    (if (and (= n 0) (>= (length digits) 8))
        (list->string digits)
        (loop (quotient n 16) (cons (string-ref "0123456789abcdef" (remainder n 16)) digits)))))


;; The symbols of the library and of the program by address, then name, but the .L labels
(define (write-map path interface linked)
  (let ((symbols (append (map (lambda (x) (cons (cadr x) (caddr x)))
                              (filter (lambda (x) (eq? (car x) 'symbol)) interface))
                         (filter (lambda (x)
                                   (not (and (>= (string-length (car x)) 2)
                                             (string=? (substring (car x) 0 2) ".L"))))
                                 (linked-symbols linked)))))
    (write-file path
                (lambda ()
                  (for-each (lambda (x)
                              (display (hex (cdr x)))
                              (display " ")
                              (display (car x))
                              (newline))
                            (list-sort (lambda (a b)
                                         (or (< (cdr a) (cdr b))
                                             (and (= (cdr a) (cdr b)) (string<? (car a) (car b)))))
                                       symbols))))))


;; The value of option name in args, or #f
(define (option name args)
  (let ((tail (member name args)))
    (and tail
         (if (pair? (cdr tail))
             (cadr tail)
             (errorf 'schemec "~a expects an argument" name)))))


;; args without the options and their values
(define (operands args)
  (cond
   ((null? args) '())
   ((member (car args) '("--lib" "--dump" "--obj" "-o" "--map" "--embed" "--libdir"))
    (operands (cddr args)))
   ((member (car args) '("-S")) (operands (cdr args)))
   (else (cons (car args) (operands (cdr args))))))


(let* ((args (cdr (command-line)))
       (lib (option "--lib" args))
       (obj (option "--obj" args))
       (out (option "-o" args))
       (map-file (option "--map" args))
       (pass (let ((name (option "--dump" args)))
               (and name (string->symbol name)))))
  (when (and pass (not (memq pass dump-passes)))
    (errorf 'schemec "unknown pass ~a, expected one of ~a" pass dump-passes))
  (parameterize ((dump-pass pass))
    (if lib
        (let*-values (((entries interface) (compile-scheme-library (library-forms (operands args))))
                      ((asm) (program-asm entries)))
          (write-file (string-append lib "/lib.s") (lambda () (print-program asm)))
          (when obj
            (write-binary-file obj (object-file (encode-asm asm))))
          (let-values (((segments text) (library-image asm interface)))
            (let ((stamp (stamp (append segments (list (string->utf8 text))))))
              (write-binary-file (string-append lib "/lib.img") (image-bytes stamp segments))
              (write-file (string-append lib "/lib.scm")
                          (lambda ()
                            (write `(stamp ,stamp))
                            (newline)
                            (display text))))))
        (let-values (((image interface) (read-library (option "--libdir" args))))
          (unless (or out obj pass (member "-S" args))
            (errorf 'schemec "expected -o FILE, -S, --obj FILE or --dump PASS"))
          (let ((asm (program-asm (compile-scheme-program interface (read-all) (embedded-files args)))))
            (when (member "-S" args)
              (print-program asm))
            (when obj
              (write-binary-file obj (object-file (encode-asm asm))))
            (when out
              (let ((linked (link-program asm image interface)))
                (write-binary-file out (executable-file (image-segments image) (linked-segments linked)
                                                        (library-symbol interface "_start")))
                (chmod out #o755)
                (when map-file
                  (write-map map-file interface linked)))))))))


;; Compiled by itself, the value of the last form would be printed
(exit)
