#!/usr/bin/env -S scheme --libdirs compiler::build/chez --program

;; The compiler: every stage in one process.
;; schemec [--run] [-S | --pass PASS] [--display] [-o FILE] SOURCE: the program SOURCE, - for
;; stdin, linked with the library into the executable FILE (elf.sls), by default SOURCE without
;; its .scm or .ss extension; --map MAP also writes the address of every symbol to MAP
;; Top-level (include FILE ...) forms are spliced first, FILE relative to the including file
;; --run: then replaces the process with the executable, which is written only with -o
;; --display: the executable prints the value of the program's last form
;; -S: the program's asm instead, for as and ld with build/lib.o; --pass PASS: its IR after PASS
;; (see dump-passes); both to the standard output, or to FILE with -o
;; schemec --lib DIR FILE...: the library, lib/*.ss in file name order, into DIR/lib.s, the
;; image DIR/lib.img (layout.sls) and the interface DIR/lib.scm, with the image's stamp and
;; addresses; with --pass, the library's IR too
;; --obj FILE: also writes the ELF object of the asm (encode.sls, object.sls), for asmcheck.py;
;; without -o, no executable
;; --embed NAME=FILE, any number of times: the program's (embedded-file NAME) gives the bytes of
;; FILE; --embed-datum NAME=FILE: its (embedded-datum NAME) the list of FILE's forms, static
;; The library: the image embedded as lib.img and the interface as the datum lib.scm, else build/lib.img
;; and build/lib.scm, from the project root; --libdir DIR forces DIR's files.

(import (except (chezscheme) bytevector-copy!)
        (utils)
        (library)
        (asm)
        (encode)
        (object)
        (layout)
        (elf)
        (bytes)
        (host))


;; Locals and the markers are gensyms: errors print their names
(print-gensym #f)


;; The name in the errors: the self-contained compiler carries the library
(define compiler-name (if (embedded-file "lib.img") 'marelle 'schemec))


;; The forms of the files, in order
(define (library-forms files)
  (apply append (map (lambda (file) (with-input-from-file file read-all)) files)))


;; What thunk writes to the current output port, replacing the file, which Chez's
;; with-output-to-file does not
(define (write-file path thunk)
  (when (file-exists? path)
    (delete-file path))
  (with-output-to-file path thunk))


;; Writes the bytevector bv to the file, replacing it
(define (write-binary-file path bv)
  (when (file-exists? path)
    (delete-file path))
  (let ((port (open-file-output-port path)))
    (put-bytevector port bv)
    (close-port port)))


;; The library's segments, its unit placed at the bases, scheme_program at the end of its data,
;; and the text of the interface with the address of each global symbol
(define (library-image unit interface)
  (let* ((p (place-unit unit segment-bases))
         (known (make-hashtable string-hash string=?)))
    (hashtable-set! known "scheme_program" (align-up (cadr (placement-ends p)) 8))
    (let ((linked (link-unit unit p known)))
      (values (linked-segments linked)
              (with-output-to-string
                (lambda ()
                  (for-each (lambda (x) (write x) (newline))
                            (append interface
                                    (map (lambda (s) `(symbol ,(car s) ,(cdr s)))
                                         (linked-globals linked))))))))))


;; The bytes of the file
(define (read-binary-file path)
  (let* ((port (open-file-input-port path))
         (bv (get-bytevector-all port)))
    (close-port port)
    (if (eof-object? bv) (make-bytevector 0) bv)))


;; The library's image and interface, which must come from the same build: those embedded,
;; unless dir is given, else dir's files, build's by default
(define (read-library dir)
  (let-values (((image interface)
                (let ((image (and (not dir) (embedded-file "lib.img")))
                      (forms (and (not dir) (embedded-datum "lib.scm"))))
                  (if (and image forms)
                      (values image forms)
                      (let ((dir (or dir "build")))
                        (values (read-binary-file (string-append dir "/lib.img"))
                                (with-input-from-file (string-append dir "/lib.scm") read-all)))))))
    (let ((image (read-image image)))
      (unless (eqv? (image-stamp image) (cadr (or (assq 'stamp interface) '(stamp #f))))
        (errorf compiler-name "the library's image and interface come from different builds"))
      (values image interface))))


;; The NAME=FILE values of the option, ((name path) ...)
(define (embed-options option args)
  (cond
   ((null? args) '())
   ((and (string=? (car args) option) (pair? (cdr args)))
    (let* ((spec (cadr args))
           (i (let loop ((i 0))
                (cond
                 ((= i (string-length spec)) (errorf compiler-name "~a expects NAME=FILE" option))
                 ((char=? (string-ref spec i) #\=) i)
                 (else (loop (+ i 1))))))
           (path (substring spec (+ i 1) (string-length spec))))
      (cons (list (substring spec 0 i) path)
            (embed-options option (cddr args)))))
   (else (embed-options option (cdr args)))))


;; The files of the --embed NAME=FILE options, ((name path bytes) ...)
(define (embedded-files args)
  (map (lambda (e) (list (car e) (cadr e) (read-binary-file (cadr e))))
       (embed-options "--embed" args)))


;; The forms of the files of the --embed-datum NAME=FILE options, ((name . forms) ...)
(define (embedded-datums args)
  (map (lambda (e) (cons (car e) (with-input-from-file (cadr e) read-all)))
       (embed-options "--embed-datum" args)))


;; The address of the library's global symbol name
(define (library-symbol interface name)
  (let ((x (find (lambda (x) (and (eq? (car x) 'symbol) (string=? (cadr x) name))) interface)))
    (if x (caddr x) (errorf compiler-name "no symbol ~a in the library" name))))


;; The unit as an ELF object to the file obj, unless obj is #f;
;; last, since it resolves the unit's fixups in place
(define (write-object obj unit)
  (when obj
    (write-binary-file obj (object-file unit))))


;; The program's unit linked after the library
(define (link-program unit image interface)
  (let* ((p (place-unit unit (image-ends image)))
         (known (make-hashtable string-hash string=?)))
    (for-each (lambda (x)
                (when (eq? (car x) 'symbol)
                  (hashtable-set! known (cadr x) (caddr x))))
              interface)
    (let ((linked (link-unit unit p known)))
      (unless (eqv? (cdr (assoc "scheme_program" (linked-symbols linked)))
                    (align-up (cadr (image-ends image)) 8))
        (errorf compiler-name "scheme_program is not the program's first data"))
      linked)))


(define (hex n)
  (let loop ((n n) (digits '()))
    (if (and (= n 0) (>= (length digits) 8))
        (list->string digits)
        (loop (quotient n 16) (cons (string-ref "0123456789abcdef" (remainder n 16)) digits)))))


;; The symbols of the library and of the program by address, then name, but the .L labels
(define (write-map path interface linked)
  (let ((symbols (append (map (lambda (x) (cons (cadr x) (caddr x)))
                              (filter (lambda (x) (eq? (car x) 'symbol)) interface))
                         (filter (lambda (x)
                                   (not (and (>= (string-length (car x)) 2)
                                             (string=? (substring (car x) 0 2) ".L"))))
                                 (linked-symbols linked)))))
    (write-file path
                (lambda ()
                  (for-each (lambda (x)
                              (display (hex (cdr x)))
                              (display " ")
                              (display (car x))
                              (newline))
                            (list-sort (lambda (a b)
                                         (or (< (cdr a) (cdr b))
                                             (and (= (cdr a) (cdr b)) (string<? (car a) (car b)))))
                                       symbols))))))


;; The value of option name in args, or #f
(define (option name args)
  (let ((tail (member name args)))
    (and tail
         (if (pair? (cdr tail))
             (cadr tail)
             (errorf compiler-name "~a expects an argument" name)))))


(define valued-options '("--lib" "--pass" "--obj" "-o" "--map" "--embed" "--embed-datum" "--libdir"))

(define flag-options '("-S" "--display" "--run"))


;; args without the options and their values; an unknown option is an error
(define (operands args)
  (cond
   ((null? args) '())
   ((member (car args) valued-options)
    (if (pair? (cdr args))
        (operands (cddr args))
        (errorf compiler-name "~a expects an argument" (car args))))
   ((member (car args) flag-options) (operands (cdr args)))
   ((and (> (string-length (car args)) 1) (char=? (string-ref (car args) 0) #\-))
    (errorf compiler-name "unknown option ~a" (car args)))
   (else (cons (car args) (operands (cdr args))))))


;; The executable's default name: source without its .scm or .ss extension
(define (default-output source)
  (let* ((n (string-length source))
         (ext (find (lambda (ext)
                      (let ((k (string-length ext)))
                        (and (> n k) (string=? (substring source (- n k) n) ext))))
                    '(".scm" ".ss"))))
    (if ext
        (substring source 0 (- n (string-length ext)))
        (errorf compiler-name "cannot name the executable after ~a, expected -o FILE" source))))


;; The directory of the file path, . for none
(define (path-directory path)
  (let loop ((i (- (string-length path) 1)))
    (cond
     ((< i 0) ".")
     ((char=? (string-ref path i) #\/) (if (= i 0) "/" (substring path 0 i)))
     (else (loop (- i 1))))))


(define (path-join dir path)
  (if (or (string=? dir ".")
          (and (> (string-length path) 0) (char=? (string-ref path 0) #\/)))
      path
      (string-append dir "/" path)))


(define max-include-depth 64)


;; The top-level forms, also inside begins, with each (include file ...) a begin of the files'
;; forms, a file relative to dir, the directory of the file including it;
;; stack, the files being included
(define (expand-includes forms dir stack)
  (map (lambda (x)
         (cond
          ((and (pair? x) (eq? (car x) 'begin) (list? x))
           `(begin ,@(expand-includes (cdr x) dir stack)))
          ((and (pair? x) (eq? (car x) 'include))
           (unless (and (list? x) (pair? (cdr x)) (for-all string? (cdr x)))
             (errorf compiler-name "invalid include ~s" x))
           `(begin
              ,@(apply append
                       (map (lambda (file)
                              (let ((path (path-join dir file)))
                                (unless (file-exists? path)
                                  (errorf compiler-name "cannot include ~a: no such file" path))
                                (when (or (member path stack) (>= (length stack) max-include-depth))
                                  (errorf compiler-name "~a includes itself" path))
                                (expand-includes (with-input-from-file path read-all)
                                                 (path-directory path)
                                                 (cons path stack))))
                            (cdr x)))))
          (else x)))
       forms))


;; Calls thunk with the current output port writing to the file path, or as it is without path
(define (with-output path thunk)
  (if path (write-file path thunk) (thunk)))


(let* ((args (cdr (command-line)))
       (files (operands args))
       (lib (option "--lib" args))
       (obj (option "--obj" args))
       (out (option "-o" args))
       (map-file (option "--map" args))
       (asm? (member "-S" args))
       (run? (member "--run" args))
       (pass (let ((name (option "--pass" args)))
               (and name (string->symbol name)))))
  (when (and pass (not (memq pass dump-passes)))
    (errorf compiler-name "unknown pass ~a, expected one of ~a" pass dump-passes))
  (parameterize ((dump-pass pass))
    (if lib
        (let*-values (((entries interface) (compile-scheme-library (library-forms files)))
                      ((asm) (program-asm entries)))
          (write-file (string-append lib "/lib.s") (lambda () (print-program asm)))
          (let ((unit (encode-asm asm)))
            (let-values (((segments text) (library-image unit interface)))
              (let ((stamp (stamp (append segments (list (string->utf8 text))))))
                (write-binary-file (string-append lib "/lib.img") (image-bytes stamp segments))
                (write-file (string-append lib "/lib.scm")
                            (lambda ()
                              (write `(stamp ,stamp))
                              (newline)
                              (display text)))))
            (write-object obj unit)))
        (begin
          (unless (= (length files) 1)
            (errorf compiler-name "expected one source file, - for the standard input"))
          (when (and run? (or asm? pass))
            (errorf compiler-name "--run does not go with -S or --pass"))
          (let*-values (((source) (car files))
                        ;; The executable's name, #f for none
                        ((name) (cond
                                 ((or asm? pass) #f)
                                 (out out)
                                 (run? source)
                                 (obj #f)
                                 (else (default-output source))))
                        ((program) (if (string=? source "-")
                                       (expand-includes (read-all) "." '())
                                       (expand-includes (with-input-from-file source read-all)
                                                        (path-directory source)
                                                        (list source))))
                        ((image interface) (read-library (option "--libdir" args))))
            (let ((compile
                   (lambda ()
                     (program-asm
                      (compile-scheme-program interface program (embedded-files args)
                                              (embedded-datums args)
                                              (and (member "--display" args) #t))))))
              (cond
               ((or asm? pass)
                (with-output out
                             (lambda ()
                               (let ((asm (compile)))
                                 (when asm?
                                   (print-program asm))
                                 (when obj
                                   (write-object obj (encode-asm asm)))))))
               ((not name)
                (write-object obj (encode-asm (compile))))
               (else
                (let* ((unit (encode-asm (compile)))
                       (linked (link-program unit image interface))
                       (bytes (executable-file (image-segments image) (linked-segments linked)
                                               (library-symbol interface "_start"))))
                  (write-object obj unit)
                  (when map-file
                    (write-map map-file interface linked))
                  (when (or out (not run?))
                    (write-binary-file name bytes)
                    (chmod name #o755))
                  (when run?
                    (execute-bytevector bytes name)))))))))))
