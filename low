#!/usr/bin/env scheme-script

;; scheme-script low < SOURCE > IR
;; Single pass: each def is compiled and printed before the next is read.

;; There are 4 kinds:
;; - raw    a plain word
;; - val    a tagged value
;; - never  does not return
;; - void   returns nothing
;;
;; An expression is compiled either
;; - as a value
;;   - compile-value, giving an operand
;;   - compile-result, same but checking the kind
;; - as a branch
;;   - compile-branch, giving a conditional jump

(import (chezscheme)
        (utils))


(define strings '())
(define strings-counter (make-counter))

(define defs '())
(define fn-counter (make-counter))
(define name-kinds (make-eq-hashtable))

(define globals? #f)

(define blocks '())
(define block-label #f)
(define code '())
(define tmp-counter #f)
(define raw-counter #f)
(define label-counter #f)


(define (intern-string! x)
  (assert (string? x))
  (cond
   ((assoc x strings) => cdr)
   (else
    (let ((name (format "str~a" (strings-counter))))
      (set! strings (acons x name strings))
      (print-entry (list 'string name x))
      name))))


(define (lower-operand x)
  (if (pair? x)
      (case (car x)
        ((val) `(tmp ,(cadr x)))
        ((as-raw as-val) (lower-operand (cadr x)))
        (else x))
      x))


(define (lower-block block)
  (define (lower-instr instr)
    (cons (car instr) (map lower-operand (cdr instr))))
  (define (lower tag label . instrs)
    `(block ,label ,@(map lower-instr instrs)))
  (apply lower block))


(define (print-entry x)
  (if (eq? (car x) 'function)
      (begin
        (printf "(function ~s ~s" (cadr x) (caddr x))
        (for-each (lambda (b)
                    (printf "\n  (block ~s" (cadr b))
                    (for-each (lambda (i) (printf "\n    ~s" i)) (cddr b))
                    (display ")"))
                  (cdddr x))
        (display ")\n\n"))
      (printf "~s\n\n" x)))


(define (emit! instr)
  (set! code (cons instr code)))


(define (close-block!)
  (set! blocks (cons `(block ,block-label ,@(reverse code)) blocks))
  (set! code '()))


(define (start-block! label)
  (close-block!)
  (set! block-label label))


(define (fresh-tmp kind)
  (list kind ((if (eq? kind 'raw) raw-counter tmp-counter))))


(define (fresh-label)
  (label-counter))


(define (kind x)
  (cond
   ((string? x) 'raw)
   ((memq (car x) '(quad as-raw)) 'raw)
   ((memq (car x) '(raw never void)) (car x))
   (else 'val)))


(define (check-kind x k expr)
  (unless (eq? (kind x) k)
    (error 'check-kind (format "expected a ~a" k) expr)))


;; params   (symbol . kind) pairs
;; result   kind
;; n        number of the emitted function, #f when the def is only inlined
;; as       name Scheme sees, from (:as name), else the def name
(define-record-type def
  (fields name params result inline? public? body n as))


(define (def-proc def) (format "proc~a" (def-n def)))
(define (def-code def)
  (if (eq? (def-name def) 'main)
      "scheme_main"
      (format "fn~a" (def-n def))))
(define (def-params-names def) (map car (def-params def)))
(define (def-params-kinds def) (map cdr (def-params def)))


(define (lookup-def name)
  (let ((entry (assq name defs)))
    (and entry (cdr entry))))


(define binary-ops
  '((bit-and . and)
    (bit-or . or)
    (raw+ . add)
    (raw- . sub)
    (raw* . mul)
    (raw<< . sal)
    (raw>> . sar)))


(define keywords
  (append (map car binary-ops)
          '(if when unless let let* begin set!
            and or not
            raw as-raw as-val
            raw= raw< raw> raw<= raw>=
            c-call
            load store alloc self address)))


;; (val x) => (x . val)
(define (parse-param x)
  (unless (and (list? x)
               (= (length x) 2)
               (memq (car x) '(val raw))
               (symbol? (cadr x)))
    (error 'parse-param "invalid parameter" x))
  (cons (cadr x) (car x)))


(define (parse-result x)
  (cond
   ((null? x) 'void)
   ((eq? x '!) 'never)
   ((and (list? x) (= (length x) 1) (memq (car x) '(val raw))) (car x))
   (else (error 'parse-result "invalid result" x))))


;; Bind x as a def or a local: a def name is never reused, and a local
;; name only after the local that had it went out of scope (free)
(define (bind-name! x kind)
  (let ((old (hashtable-ref name-kinds x #f)))
    (cond
     ((not old))
     ((eq? kind 'def)
      (error 'bind-name! (if (eq? old 'def) "name already defined" "def named like a local") x))
     ((eq? old 'def)
      (error 'bind-name! "local variable named like a def" x))
     ((eq? old 'local)
      (error 'bind-name! "shadowed variable" x)))
    (hashtable-set! name-kinds x kind)))


(define (unbind-local! x)
  (hashtable-set! name-kinds x 'free))


;; Bind the params, then the variables of each let in body while it is in scope;
;; malformed forms are scanned as plain lists, the compiler rejects them later
(define (bind-locals! params body)
  (define (bindings? x)
    (and (list? x)
         (for-all (lambda (b)
                    (and (list? b)
                         (= (length b) 2) (symbol? (car b))))
                  x)))
  (define (walk x)
    (cond
     ((not (list? x)))
     ((null? x))
     ((eq? (car x) 'quote))
     ((and (memq (car x) '(let let*))
           (>= (length x) 3)
           (bindings? (cadr x)))
      (let ((star? (eq? (car x) 'let*))
            (vars (map car (cadr x))))
        (for-each (lambda (b)
                    (walk (cadr b))
                    (when star?
                      (bind-name! (car b) 'local)))
                  (cadr x))
        (unless star?
          (for-each (lambda (v) (bind-name! v 'local)) vars))
        (for-each walk (cddr x))
        (for-each unbind-local! vars)))
     (else (for-each walk x))))
  (for-each (lambda (p) (bind-name! p 'local)) params)
  (for-each walk body)
  (for-each unbind-local! params))


;; (def name (param ...) -> (kind ...) (attr ...) body ...)
(define (parse-def form)
  (unless (and (list? form)
               (>= (length form) 7)
               (eq? (car form) 'def)
               (symbol? (cadr form))
               (list? (caddr form))
               (eq? (cadddr form) '->)
               (list? (list-ref form 5)))
    (error 'parse-def "invalid def" form))
  (let* ((attrs (list-ref form 5))
         (body (list-tail form 6))
         (name (cadr form))
         (inline? (and (memq ':inline attrs) #t))
         (public? (and (memq ':public attrs) #t))
         (as (find pair? attrs)))
    (for-each (lambda (a)
                (unless (or (memq a '(:inline :public))
                            (and (pair? a) (eq? (car a) ':as)
                                 (= (length a) 2) (symbol? (cadr a))))
                  (error 'parse-def "unknown attribute" a)))
              attrs)
    (when (and as (not public?))
      (error 'parse-def ":as requires :public" name))
    (when (memq name keywords)
      (error 'parse-def "name already defined" name))
    (when (and (eq? name 'main)
               (or inline? (not (null? (caddr form))) (not (equal? (list-ref form 4) '(val)))))
      (error 'parse-def "main must be a non-inline def with no parameters and a val result" form))
    (let ((params (map parse-param (caddr form))))
      (bind-name! name 'def)
      (bind-locals! (map car params) body)
      (make-def name params
                (parse-result (list-ref form 4))
                inline? public? body
                (and (or public? (not inline?)) (fn-counter))
                (if as (cadr as) name)))))


(define (lookup-var env x)
  (let ((entry (assq x env)))
    (if entry
        (cdr entry)
        (error 'lookup-var "unbound variable" x))))


;; The operand for x, or #f when x is not an immediate
(define (immediate x)
  (define (tag t x)
    `(as-val (quad ,(+ t (* x 8)))))
  (cond
   ((and (integer? x) (exact? x)
         (<= (- (expt 2 60)) x (- (expt 2 60) 1)))
    (tag 1 x))
   ((boolean? x)
    (tag 2 (if x 1 0)))
   ((equal? x ''())
    (tag 2 2))
   ((eq? x 'undef)
    (tag 2 3))
   (else #f)))


(define tests
  '((raw=  je  jne)
    (raw<  jl  jge)
    (raw<= jle jg)
    (raw>  jg  jle)
    (raw>= jge jl)))


(define (test-form? expr)
  (and (pair? expr)
       (assq (car expr) tests)))


(define (binary-op? expr)
  (and (pair? expr)
       (assq (car expr) binary-ops)))


(define (call-form? expr)
  (and (pair? expr)
       (symbol? (car expr))
       (not (memq (car expr) keywords))
       (lookup-def (car expr))))


(define (inline-call? expr)
  (let ((def (call-form? expr)))
    (and def (def-inline? def) def)))


;; Emits the code of expr and returns its operand, one of:
;; - a slot: (val n), (raw n), (arg n), (self)
;; - a constant: (quad n), or a string, the address of a symbol
;; - a marker: (void), (never)
;; - a cast: (as-val x) or (as-raw x), only for kind, removed by lower-operand
;; A (raw n) is never inside a cast: as-val copies it into a tmp
(define (compile-value env expr)
  (cond
   ((symbol? expr)
    (let ((op (lookup-var env expr)))
      ;; Copied, so a later set! does not change an operand already computed
      (if (and (pair? op) (eq? (car op) 'mutable))
          (emit-op! 'mov (kind (cadr op)) (cdr op))
          op)))

   ((immediate expr)) ;; after symbol? because of 'undef

   ((string? expr)
    (intern-string! expr))

   ((test-form? expr)
    (compile-value env `(if ,expr #t #f)))

   ((call-form? expr)
    => (lambda (def)
         (if (def-inline? def)
             (compile-inline env def expr (lambda (env x) (compile-result env def x)))
             (emit-op! 'call 'val
                       (cons* (def-code def) (def-proc def) (compile-args env def expr))))))

   ((binary-op? expr)
    => (lambda (entry)
         (emit-op! (cdr entry) 'raw (compile-operands env expr '(raw raw)))))

   ((and (pair? expr)
         (symbol? (car expr)))
    (case (car expr)
      ((if)
       (unless (= (length expr) 4)
         (error 'compile-value "invalid if" expr))
       (compile-if env (cadr expr) (caddr expr) (cadddr expr)))

      ((let)
       (compile-let env expr compile-value))

      ((let*)
       (compile-value env (let*->let expr)))

      ((begin)
       (compile-seq env (begin-body expr) compile-value))

      ;; (set! x expr): x is a local variable
      ((set!)
       (unless (and (= (length expr) 3) (symbol? (cadr expr)))
         (error 'compile-value "invalid set!" expr))
       (let ((var (lookup-var env (cadr expr))))
         (assert (eq? (car var) 'mutable))
         (let ((slot (cadr var)))
           (emit! `(mov ,slot ,(compile-kind env (caddr expr) (kind slot) expr)))
           '(void))))

      ((when unless)
       (unless (>= (length expr) 3)
         (error 'compile-value "invalid when or unless" expr))
       ;; The body for effect, so it may have any kind
       (let ((label-skip (fresh-label)))
         (compile-branch env (cadr expr) (eq? (car expr) 'unless) label-skip)
         (for-each (lambda (x) (compile-value env x)) (cddr expr))
         (start-block! label-skip)
         (immediate 'undef)))

      ((and or not)
       (compile-value env `(if ,expr #t #f)))

      ((raw)
       (unless (and (= (length expr) 2)
                    (integer? (cadr expr))
                    (exact? (cadr expr))
                    (<= (- (expt 2 63)) (cadr expr) (- (expt 2 64) 1)))
         (error 'compile-value "invalid raw literal" expr))
       `(quad ,(cadr expr)))

      ;; Casts only wrap the operand,
      ;; except that as-val copies a raw slot into a tmp, since the GC scans only tmps
      ((as-raw as-val)
       (unless (= (length expr) 2)
         (error 'compile-value "invalid cast" expr))
       (let ((op (compile-kind env (cadr expr) (if (eq? (car expr) 'as-raw) 'val 'raw) expr)))
         (if (and (eq? (car expr) 'as-val)
                  (not (zero? (raws-in op))))
             (emit-op! 'mov 'val (list op))
             (list (car expr) op))))

      ;; (c-call name arg ...): raw arguments and result, not a safepoint
      ((c-call)
       (unless (and (>= (length expr) 2) (symbol? (cadr expr)))
         (error 'compile-value "invalid c-call" expr))
       (emit-op! 'ccall 'raw
                 (cons (symbol->string (cadr expr))
                       (compile-exprs env (cddr expr) (map (lambda (x) 'raw) (cddr expr)) expr))))

      ;; (load address index): the raw word at word index of address
      ((load)
       (emit-op! 'load 'raw (compile-operands env expr '(raw raw))))

      ;; (store address index x): sets the word at word index of address to x
      ((store)
       (unless (= (length expr) 4)
         (error 'compile-value "invalid store" expr))
       (let* ((base (compile-kind env (cadr expr) 'raw expr))
              (index (compile-kind env (caddr expr) 'raw expr))
              (x (compile-value env (cadddr expr))))
         (unless (memq (kind x) '(val raw))
           (error 'compile-value "expected a val or a raw" expr))
         (emit! `(store ,base ,index ,x))
         '(void)))

      ;; (alloc nwords): the raw address of nwords new zeroed words
      ((alloc)
       (let ((ops (compile-operands env expr '(raw))))
         (when (and (eq? (caar ops) 'quad) (<= (cadar ops) 0))
           (error 'compile-value "invalid alloc" expr))
         (emit-op! 'alloc 'raw ops)))

      ((self)
       (unless (= (length expr) 1)
         (error 'compile-value "invalid self" expr))
       '(self))

      ;; (address "name"): the address of symbol name
      ((address)
       (unless (and (= (length expr) 2)
                    (string? (cadr expr)))
         (error 'compile-value "invalid address" expr))
       (cadr expr))

      (else
       (error 'compile-value "unsupported operation" expr))))

   (else
    (error 'compile-value "unsupported expression" expr))))


(define (compile-kind env x k form)
  (let ((op (compile-value env x)))
    (check-kind op k form)
    op))


(define (compile-operands env expr kinds)
  (compile-exprs env (cdr expr) kinds expr))


;; form is the whole expression, for errors
(define (compile-exprs env exprs kinds form)
  (unless (= (length exprs) (length kinds))
    (error 'compile-exprs "wrong number of operands" form))
  (let loop ((exprs exprs)
             (kinds kinds)
             (ops '()))
    (if (null? exprs)
        (reverse ops)
        (loop (cdr exprs)
              (cdr kinds)
              (cons (compile-kind env (car exprs) (car kinds) form) ops)))))


(define (compile-args env def expr)
  (compile-operands env expr (def-params-kinds def)))


;; Every expression but the last for effect, then (compile-last env last)
(define (compile-seq env exprs compile-last)
  (let-values (((init last) (split-last exprs)))
    (for-each (lambda (x) (compile-value env x)) init)
    (compile-last env last)))


;; The value of a def's last expression x, checked against its result
(define (compile-result env def x)
  (let ((op (compile-value env x))
        (result (def-result def)))
    (cond
     ((eq? (kind op) 'never)
      op)
     ((eq? result 'never)
      (emit! '(unreachable))
      '(never))
     ((eq? result 'void)
      '(void))
     (else
      (check-kind op result (def-name def)) op))))


(define (compile-inline env def expr compile-last)
  (let* ((names (def-params-names def))
         (args (compile-args env def expr))
         (callee-env (map (lambda (name arg)
                            (bind-var name arg (def-body def) #f))
                          names args)))
    (compile-seq callee-env (def-body def) compile-last)))


(define (compile-let env expr compile-last)
  (unless (and (>= (length expr) 3)
               (list? (cadr expr))
               (for-all (lambda (b)
                          (and (list? b)
                               (= (length b) 2)
                               (symbol? (car b))))
                        (cadr expr)))
    (error 'compile-let "invalid let" expr))
  (let loop ((bindings (cadr expr))
             (body-env env))
    (if (null? bindings)
        (compile-seq body-env (cddr expr) compile-last)
        (let ((op (compile-value env (cadar bindings))))
          (unless (memq (kind op) '(val raw))
            (error 'compile-let "expected a val or a raw" (car bindings)))
          (loop (cdr bindings)
                (cons (bind-var (caar bindings) op (cddr expr) #f) body-env))))))


;; (let* (binding ...) body ...) => nested lets
(define (let*->let expr)
  (unless (and (>= (length expr) 3) (list? (cadr expr)))
    (error 'let*->let "invalid let*" expr))
  (let loop ((bindings (cadr expr)))
    (if (or (null? bindings) (null? (cdr bindings)))
        `(let ,bindings ,@(cddr expr))
        `(let (,(car bindings)) ,(loop (cdr bindings))))))


(define (begin-body expr)
  (unless (>= (length expr) 2)
    (error 'begin-body "invalid begin" expr))
  (cdr expr))


;; Whether x contains a set! of the variable name;
;; malformed forms are scanned as plain lists, the compiler rejects them later
(define (assigns? name x)
  (cond
   ((not (list? x)) #f)
   ((null? x) #f)
   ((eq? (car x) 'quote) #f)
   ((and (eq? (car x) 'set!)
         (= (length x) 3)
         (eq? (cadr x) name))
    #t)
   (else (exists (lambda (y) (assigns? name y)) x))))


;; The env entry of a variable bound to op, with body its scope;
;; an assigned variable gets its own slot, unless op already is (own?)
(define (bind-var name op body own?)
  (cond
   ((not (exists (lambda (x) (assigns? name x)) body))
    (cons name op))
   (own?
    (cons name `(mutable ,op)))
   (else
    (cons name `(mutable ,(emit-op! 'mov (kind op) (list op)))))))


;; and/or in a test: short is the truth that ends the evaluation early
(define (compile-logic-branch env expr jump-if label)
  (assert (memq (car expr) '(and or)))
  (let ((short (eq? (car expr) 'or))
        (ops (cdr expr)))
    (cond
     ((null? ops)
      (unless (eq? jump-if short)
        (emit! `(jmp ,label))))
     ((eq? jump-if short)
      (for-each (lambda (x) (compile-branch env x short label)) ops))
     (else
      (let ((label-skip (fresh-label)))
        (let-values (((init last) (split-last ops)))
          (for-each (lambda (x) (compile-branch env x short label-skip)) init)
          (compile-branch env last jump-if label))
        (start-block! label-skip))))))


;; Jumps to label when the truth of test equals jump-if
(define (compile-branch env test jump-if label)
  (cond
   ((and (pair? test) (memq (car test) '(and or)))
    (compile-logic-branch env test jump-if label))

   ((and (pair? test) (eq? (car test) 'not))
    (unless (= (length test) 2)
      (error 'compile-branch "invalid not" test))
    (compile-branch env (cadr test) (not jump-if) label))

   ((test-form? test)
    => (lambda (entry)
         (let ((ops (compile-operands env test '(raw raw))))
           (emit! `(cmp ,@ops))
           (emit! `(,(if jump-if (cadr entry) (caddr entry)) ,label)))))

   ((and (pair? test) (eq? (car test) 'let))
    (compile-let env test (lambda (env x) (compile-branch env x jump-if label))))

   ((and (pair? test) (eq? (car test) 'let*))
    (compile-branch env (let*->let test) jump-if label))

   ((and (pair? test) (eq? (car test) 'begin))
    (compile-seq env (begin-body test)
                 (lambda (env x) (compile-branch env x jump-if label))))

   ((inline-call? test)
    => (lambda (def)
         (unless (eq? (def-result def) 'val)
           (error 'compile-branch "expected a val" test))
         (compile-inline env def test
                         (lambda (env x) (compile-branch env x jump-if label)))))

   (else
    (let ((op (compile-kind env test 'val test)))
      (emit! `(cmp ,op ,(immediate #f)))
      (emit! `(,(if jump-if 'jne 'je) ,label))))))


(define (compile-if env test then else)
  (let* ((label-false (fresh-label))
         (label-end (fresh-label)))
    (compile-branch env test #f label-false)
    ;; A branch that does not return takes the kind of the other one
    (let* ((a (compile-value env then))
           (slot? (memq (kind a) '(val raw)))
           (dst (if slot? (fresh-tmp (kind a)) a)))
      (unless (eq? (kind a) 'never)
        (when slot?
          (emit! `(mov ,dst ,a)))
        (emit! `(jmp ,label-end)))
      (start-block! label-false)
      (let ((b (compile-value env else)))
        (cond
         ((eq? (kind a) 'never)
          (set! dst b))
         ((not (eq? (kind b) 'never))
          (check-kind b (kind a) `(if ,test ,then ,else))
          (when slot?
            (emit! `(mov ,dst ,b))))))
      (start-block! label-end)
      dst)))


;; (op dst src ...) with a fresh dst of kind k
(define (emit-op! op k srcs)
  (let ((dst (fresh-tmp k)))
    (emit! `(,op ,dst ,@srcs))
    dst))


(define jumps '(je jne jl jle jg jge jmp))


;; Sets of raws are integers: bit n stands for (raw n)
(define (raws-in x)
  (cond
   ((not (pair? x)) 0)
   ((eq? (car x) 'raw) (ash 1 (cadr x)))
   (else (logor (raws-in (car x)) (raws-in (cdr x))))))


(define (set-minus a b)
  (logand a (lognot b)))


;; Instructions without a destination
(define (no-dst? instr)
  (memq (car instr) `(cmp store ret tailcall unreachable ,@jumps)))


(define (instr-defs instr)
  (if (no-dst? instr) 0 (raws-in (list (cadr instr)))))


(define (instr-uses instr)
  (raws-in (if (no-dst? instr) (cdr instr) (cddr instr))))


;; The raws live before instr, given those live after it
(define (live-before instr live)
  (logor (set-minus live (instr-defs instr))
         (instr-uses instr)))


(define (falls-through? block)
  (let ((instrs (cddr block)))
    (not (and (pair? instrs)
              (memq (caar (last-pair instrs)) '(jmp ret tailcall unreachable))))))


;; Raw slots hold untagged words, so none may be live across a safepoint
(define (check-gc-safety name body)
  ;; Maps each block label to the raws live at its start
  (let ((ins (make-vector (+ 1 (apply max (map cadr body))) 0)))
    (define (live-in label)
      (vector-ref ins label))

    ;; The raws live at the end of block, before next
    (define (live-end block next)
      (if (and next (falls-through? block)) (live-in (cadr next)) 0))

    ;; Calls fn on each instruction of block, last first, with the raws live after it;
    ;; returns the raws live at the start of block
    (define (walk-block block next fn)
      (fold-left (lambda (live instr)
                   (let ((live (if (memq (car instr) jumps)
                                   (logor live (live-in (cadr instr)))
                                   live)))
                     (fn instr live)
                     (live-before instr live)))
                 (live-end block next)
                 (reverse (cddr block))))

    (define (walk-all fn)
      (for-each (lambda (b next)
                  (vector-set! ins (cadr b) (walk-block b next fn)))
                body (append (cdr body) '(#f))))

    (let loop ()
      (let ((before (vector-copy ins)))
        (walk-all (lambda (instr live) #f))
        (unless (equal? before ins)
          (loop))))

    (walk-all (lambda (instr live)
                (when (memq (car instr) '(call tailcall alloc))
                  (let ((across (set-minus live (instr-defs instr))))
                    (unless (zero? across)
                      (error 'check-gc-safety "raw live across a safepoint"
                             name `(raw ,(bitwise-first-bit-set across)) instr))))))))


;; Prints the def's strings, export, name, procedure object and function
(define (emit-def def)
  (let* ((params (def-params def))
         (arity (length params))
         (proc (def-proc def))
         (name (string-append proc "_name")))
    (unless (and (for-all (lambda (p) (eq? (cdr p) 'val)) params)
                 (eq? (def-result def) 'val))
      (error 'emit-def "raw parameter or result in a non-inline def" (def-name def)))
    (set! blocks '())
    (set! block-label 0)
    (set! code '())
    (set! tmp-counter (make-counter))
    (set! raw-counter (make-counter))
    (set! label-counter (make-counter))
    (let ((result (compile-seq (map (lambda (p i)
                                      (bind-var (car p) (list 'arg (+ i 1)) (def-body def) #t))
                                    params (iota arity))
                               (def-body def)
                               (lambda (env x) (compile-result env def x)))))
      (unless (eq? (kind result) 'never)
        (emit! `(ret ,result)))
      (close-block!)
      (let ((body (reverse blocks)))
        (check-gc-safety (def-name def) body)
        (when (def-public? def)
          (print-entry `(export ,proc)))
        (when (eq? (def-name def) 'main)
          (print-entry '(export "scheme_main")))
        (print-entry `(string ,name ,(symbol->string (def-as def))))
        (print-entry `(data ,proc (quad "procedure_type") (quad ,arity)
                            (quad ,(def-code def)) (quad ,name) (quad 0)))
        (print-entry `(function ,(def-code def) (arity ,arity)
                                ,@(map lower-block body)))))))


;; (globals n): the n global cells, initialized to undef
(define (emit-globals form)
  (unless (and (= (length form) 2) (integer? (cadr form)) (exact? (cadr form)) (>= (cadr form) 0))
    (error 'emit-globals "invalid globals" form))
  (when globals?
    (error 'emit-globals "globals already defined" form))
  (set! globals? #t)
  (let ((n (cadr form)))
    (print-entry '(export "scheme_globals" "scheme_nglobals"))
    (print-entry `(cells "scheme_globals" ,n ,(cadr (lower-operand (immediate 'undef)))))
    (print-entry `(data "scheme_nglobals" (quad ,n)))))


(let loop ()
  (let ((form (read)))
    (unless (eof-object? form)
      (case (and (pair? form) (car form))
        ((def)
         (let ((def (parse-def form)))
           (when (def-n def)
             (emit-def def))
           (set! defs (acons (def-name def) def defs))))
        ((globals)
         (emit-globals form))
        (else
         (error 'low "unknown top-level form" form)))
      (loop))))

;; The runtime needs the global cells
(when (and (lookup-def 'main) (not globals?))
  (emit-globals '(globals 0)))
