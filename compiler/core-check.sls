;; Checks a def's core after assignment conversion, the input of compile.sls (grammar in
;; AGENTS.md): core forms only, every local bound once and referenced in its scope, no set!,
;; cells only read and set through %cell-ref and %cell-set!, closure references within the
;; captures. A closure body sees its formals and the locals it binds, and the static
;; procedures of the enclosing fix groups (those capturing nothing).

(library (core-check)
  (export check-core)
  (import (chezscheme)
          (parse)
          (closure)
          (defs)
          (ops))


  (define (check-core name core)
    (let ((bound (make-eq-hashtable))
          (cells (make-eq-hashtable)))
      (define (fail msg x)
        (error 'check-core (format "~a, after assignment conversion, in ~a" msg name) x))

      (define (bind! x)
        (unless (and (symbol? x) (gensym? x))
          (fail "not a local" x))
        (when (hashtable-ref bound x #f)
          (fail "local bound twice" x))
        (hashtable-set! bound x #t))

      (define (local! x scope)
        (unless (memq x scope)
          (fail "local out of scope" x)))

      ;; scope: the visible locals; statics: the static procedures; n: the number of captures of
      ;; the closure body, or #f
      (define (check x scope statics n)
        (define (sub x)
          (check x scope statics n))
        (define (bindings bs inner)
          (unless (list? bs)
            (fail "invalid bindings" x))
          (for-each (lambda (b)
                      (unless (and (list? b) (= (length b) 2))
                        (fail "invalid binding" b))
                      (sub (cadr b)))
                    bs)
          (for-each (lambda (b)
                      (bind! (car b))
                      (when (eq? (special-keyword (cadr b)) '%cell)
                        (hashtable-set! cells (car b) #t)))
                    bs)
          (append (map car bs) inner))

        (cond
         ((symbol? x)
          (local! x scope)
          (when (hashtable-ref cells x #f)
            (fail "cell read as a value" x)))
         ((or (immediate? x) (vector-literal? x) (not (pair? x))))
         (else
          (case (special-keyword x)
            ;; Malformed source forms keep the errors compile.sls gave them
            ((if)
             (let-values (((test then else) (parse-if x)))
               (for-each sub (list test then else))))
            ((begin)
             (for-each sub (parse-begin x)))
            ((let)
             (if (named-let? x)
                 (let-values (((name bs xs) (parse-named-let x)))
                   (bind! name)
                   (let ((scope (bindings bs (cons name scope))))
                     (for-each (lambda (y) (check y scope statics n)) xs)))
                 (let-values (((bs xs) (parse-let x)))
                   (let ((scope (bindings bs scope)))
                     (when (null? xs)
                       (fail "empty body" x))
                     (for-each (lambda (y) (check y scope statics n)) xs)))))
            ((fix)
             (let* ((bs (cadr x))
                    (scope (append (map car bs) scope))
                    (statics (append (map car (filter (lambda (b) (null? (cadadr b))) bs))
                                     statics)))
               (for-each (lambda (b) (bind! (car b))) bs)
               (for-each (lambda (b)
                           (unless (eq? (special-keyword (cadr b)) 'closure)
                             (fail "fix binding not a closure" b))
                           (check (cadr b) scope statics n))
                         bs)
               (for-each (lambda (y) (check y scope statics n)) (cddr x))))
            ((closure)
             (let-values (((captures formals xs) (parse-closure x)))
               (for-each (lambda (c) (local! c scope)) captures)
               (let ((names (formals-names formals)))
                 (for-each bind! names)
                 (when (null? xs)
                   (fail "empty body" x))
                 (for-each (lambda (y) (check y (append names statics) statics (length captures)))
                           xs))))
            ((check-defined)
             (unless (and (<= 3 (length x) 4) (symbol? (cadr x)))
               (fail "invalid check-defined" x))
             (for-each sub (cddr x)))
            ((%cell)
             (unless (= (length x) 2)
               (fail "invalid %cell" x))
             (sub (cadr x)))
            ((%cell-ref %cell-set!)
             (unless (and (= (length x) (if (eq? (special-keyword x) '%cell-ref) 2 3))
                          (hashtable-ref cells (cadr x) #f))
               (fail "invalid cell access" x))
             (local! (cadr x) scope)
             (for-each sub (cddr x)))
            ((const)
             (unless (= (length x) 2)
               (fail "invalid const" x)))
            ((low)
             (unless (memq (cadr x) low-ops)
               (fail "unknown low operation" x))
             (for-each sub (cddr x)))
            ((and or eq? when unless)
             (for-each sub (cdr x)))
            ((#f)
             (unless (list? x)
               (fail "invalid call" x))
             (when (eq? (car x) (core-def 'closure-ref))
               (unless (and n
                            (eq? (special-keyword (cadr x)) 'low)
                            (eq? (cadr (cadr x)) 'raw)
                            (< (caddr (cadr x)) n))
                 (fail "closure reference out of the captures" x)))
             (for-each sub x))
            (else
             (fail "not a core form" x))))))

      (for-each bind! (car core))
      (for-each (lambda (x) (check x (car core) '() #f)) (cdr core)))))
