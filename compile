#!/usr/bin/env scheme-script

;; scheme-script compile < SOURCE > LOW, run from the project root
;; Scheme to low: closure conversion, lambda lifting and renaming;
;; low does the rest (tmps, labels, tail calls, assigned locals)

(import (chezscheme)
        (utils))


(define int-bits 61)
(define int-min (- (expt 2 (- int-bits 1))))
(define int-max (- (expt 2 (- int-bits 1)) 1))


(define undef (void))


(define (immediate? x)
  (or (and (integer? x)
           (exact? x)
           (<= int-min x int-max))
      (boolean? x)
      (equal? x ''())
      (eq? x undef)))


(define-record-type global-binding
  (fields index))


(define-record-type local-binding
  (fields operand assigned?))


(define-record-type box-binding
  (parent local-binding))


(define-record-type bound-binding)


(define-record-type procedure-binding
  (fields proc arity))


(define-record-type primitive-binding
  (parent procedure-binding))


(define (binding-value binding)
  (if (local-binding? binding)
      (local-binding-operand binding)
      (procedure-binding-proc binding)))


(define *special-forms* '(if and or let let* lambda begin set!))


(define (special? env expr)
  (and (non-empty-list? expr)
       (let ((x (car expr)))
         (and (symbol? x)
              (memq x *special-forms*)
              (not (assq x env))))))


(define (validate-parameters args)
  (unless (list? args)
    (error 'validate-parameters "invalid parameter list" args))
  (let loop ((args args)
             (seen '()))
    (unless (null? args)
      (let ((arg (car args)))
        (unless (symbol? arg)
          (error 'validate-parameters "invalid parameter" arg))
        (when (memq arg seen)
          (error 'validate-parameters "duplicate parameter" arg))
        (loop (cdr args) (cons arg seen)))))
  (when (> (length args) 6)
    (error 'validate-parameters "too many parameters" args)))


;; (lambda (arg ...) body ...) => (values args body)
(define (parse-lambda form)
  (unless (>= (length form) 3)
    (error 'parse-lambda "invalid lambda" form))
  (validate-parameters (cadr form))
  (values (cadr form) (cddr form)))


;; (let ((var init) ...) body ...) => (values bindings body)
(define (parse-let form)
  (parse-bindings 'parse-let form #f))


;; (let* ((var init) ...) body ...) => (values bindings body)
(define (parse-let* form)
  (parse-bindings 'parse-let* form #t))


(define (parse-bindings who form duplicates-ok?)
  (unless (and (>= (length form) 3)
               (list? (cadr form)))
    (error who "invalid let" form))
  (let loop ((bs (cadr form))
             (seen '()))
    (unless (null? bs)
      (let ((b (car bs)))
        (unless (and (list? b)
                     (= (length b) 2)
                     (symbol? (car b)))
          (error who "invalid let binding" b))
        (when (and (not duplicates-ok?) (memq (car b) seen))
          (error who "duplicate let variable" (car b)))
        (loop (cdr bs) (cons (car b) seen)))))
  (values (cadr form) (cddr form)))


;; (if test then [else]) => (values test then else)
(define (parse-if form)
  (unless (<= 3 (length form) 4)
    (error 'parse-if "invalid if" form))
  (values (cadr form)
          (caddr form)
          (if (null? (cdddr form)) undef (cadddr form))))


;; (begin expr ...) => (expr ...)
(define (parse-begin form)
  (when (null? (cdr form))
    (error 'parse-begin "empty begin" form))
  (cdr form))


;; (set! var expr) => (values var expr)
(define (parse-set! form)
  (unless (and (= (length form) 3)
               (symbol? (cadr form)))
    (error 'parse-set! "invalid set!" form))
  (values (cadr form) (caddr form)))


;; compile expr in value position
;;   env is an alist of pairs (symbol . binding)
;;   code is accumulated in ctx
;; returns dst or throw an error
(define (call? env expr)
  (and (non-empty-list? expr)
       (not (immediate? expr))
       (not (special? env expr))))


;; Free variables of exprs, not bound to a bound-binding in env:
;; the referenced, the assigned, and the ones used in a lambda
(define-record-type var-sets
  (fields refs sets caps))


(define no-vars (make-var-sets '() '() '()))


(define (free-vars env exprs)
  (walk-exprs env exprs no-vars))


(define (walk-exprs env exprs acc)
  (fold-left (lambda (acc x) (walk-expr env x acc)) acc exprs))


(define (walk-expr env expr acc)
  (cond
   ((symbol? expr)
    (add-free-var env expr acc #f))

   ((special? env expr)
    (case (car expr)
      ((let)
       (let-values (((bindings body) (parse-let expr)))
         (walk-let env bindings body acc)))

      ((let*)
       (let-values (((bindings body) (parse-let* expr)))
         (walk-let* env bindings body acc)))

      ((lambda)
       (let-values (((args body) (parse-lambda expr)))
         (let ((inner (walk-exprs (bind-inside env args) body no-vars)))
           (make-var-sets (union (var-sets-refs inner) (var-sets-refs acc))
                          (union (var-sets-sets inner) (var-sets-sets acc))
                          (union (var-sets-refs inner) (var-sets-caps acc))))))

      ((set!)
       (let-values (((var value) (parse-set! expr)))
         (add-free-var env var (walk-expr env value acc) #t)))

      (else
       (walk-exprs env (cdr expr) acc))))

   ((list? expr)
    (walk-exprs env expr acc))

   (else acc)))


(define (walk-let env bindings body acc)
  (walk-exprs (bind-inside env (map car bindings))
              body
              (walk-exprs env (map cadr bindings) acc)))


(define (walk-let* env bindings body acc)
  (if (null? bindings)
      (walk-exprs env body acc)
      (walk-let* (bind-inside env (list (caar bindings)))
                 (cdr bindings)
                 body
                 (walk-expr env (cadar bindings) acc))))


(define (add-free-var env var acc set?)
  (let ((x (assq var env)))
    (if (and x (bound-binding? (cdr x)))
        acc
        (make-var-sets (adjoin var (var-sets-refs acc))
                       (if set? (adjoin var (var-sets-sets acc)) (var-sets-sets acc))
                       (var-sets-caps acc)))))


;; xs added to ys, as if adjoined in the order they were found
(define (union xs ys)
  (fold-right adjoin ys xs))


(define (bind-inside env names)
  (append (map (lambda (x) (cons x (make-bound-binding))) names) env))


(define (bind-scope env names)
  (append (map (lambda (x) (cons x #f)) names) env))


(define (captured-vars env args body)
  (filter (lambda (var)
            (let ((x (assq var env)))
              (and x (local-binding? (cdr x)))))
          (var-sets-refs (free-vars (bind-inside env args) body))))


(define (boxed? var vars)
  (and (memq var (var-sets-sets vars))
       (memq var (var-sets-caps vars))
       #t))


;; (define (name arg ...) body ...) => (values name args body)
;; (define name init) => (values name #f (init))
(define (parse-define form)
  (unless (and (non-empty-list? form)
               (eq? (car form) 'define))
    (error 'parse-define "non define form in define position" form))
  (unless (and (>= (length form) 3)
               (or (pair? (cadr form))
                   (and (symbol? (cadr form))
                        (= (length form) 3))))
    (error 'parse-define "invalid define" form))
  (if (symbol? (cadr form))
      (values (cadr form) #f (cddr form))
      (let ((name (caadr form))
            (args (cdadr form)))
        (unless (symbol? name)
          (error 'parse-define "invalid define name" form))
        (validate-parameters args)
        (values name args (cddr form)))))


(define-record-type global-def
  (fields name index args body))


(define-record-type prelude-def
  (fields name args body))


;; Map (make name i args body) over the define forms
(define (scan-defs forms make)
  (let loop ((acc '())
             (names '())
             (forms forms)
             (i 0))
    (if (null? forms)
        (reverse acc)
        (let-values (((name args body) (parse-define (car forms))))
          (when (memq name names)
            (error 'scan-defs "redefinition not allowed" name))
          (loop (cons (make name i args body) acc)
                (cons name names)
                (cdr forms)
                (+ i 1))))))


(define (scan-prelude forms)
  (scan-defs forms
             (lambda (name i args body)
               (unless args
                 (error 'scan-prelude "value define in the prelude" name))
               (make-prelude-def name args body))))


;; A captured local is either boxed or never assigned
(define (capture-binding operand binding)
  (if (box-binding? binding)
      (make-box-binding operand #t)
      (make-local-binding operand #f)))


;; names  counter of the fresh names
;; defs   the lifted defs, newest first
;; arity  arity of each def name, for known calls
(define-record-type low-program
  (fields names (mutable defs) arity)
  (protocol
   (lambda (new)
     (lambda ()
       (new (make-counter) '() (make-eq-hashtable))))))


;; (scheme-name low-name arity)
(define low-primitives
  '((eq? eq? 2)
    (+ + 2) (- - 2) (* * 2)
    (= = 2) (< < 2) (<= <= 2) (> > 2) (>= >= 2)
    (null? null? 1) (pair? pair? 1)
    (cons cons 2) (car car 1) (cdr cdr 1)
    (not scm-not 1)))


;; Every local and def gets a name x.N, unique in the program
(define (fresh-name prog x)
  (string->symbol (format "~a.~a" x ((low-program-names prog)))))


(define (add-def! prog def)
  (low-program-defs-set! prog (cons def (low-program-defs prog))))


(define (lookup-binding env x)
  (let ((entry (assq x env)))
    (unless entry
      (error 'compile-value "unknown symbol" x))
    (cdr entry)))


(define (lower-immediate x)
  (if (eq? x undef) 'undef x))


(define (lower-value prog env expr)
  (cond
   ((immediate? expr)
    (lower-immediate expr))

   ((number? expr)
    (error 'compile-value "unsupported number" expr))

   ((special? env expr)
    (case (car expr)
      ((if)
       (let-values (((test then else) (parse-if expr)))
         `(if ,(lower-test prog env test)
              ,(lower-value prog env then)
              ,(lower-value prog env else))))

      ((and)
       (lower-and prog env (cdr expr)))

      ((or)
       (lower-or prog env (cdr expr)))

      ((let let* begin)
       (lower-scope prog env expr lower-value))

      ((lambda)
       (let-values (((args body) (parse-lambda expr)))
         (lower-procedure prog env #f args body)))

      ((set!)
       (let-values (((var value) (parse-set! expr)))
         (lower-set! prog env var value)))))

   ((call? env expr)
    (lower-call prog env expr))

   ((symbol? expr)
    (let ((b (lookup-binding env expr)))
      (cond
       ((global-binding? b) `(global-ref (raw ,(global-binding-index b))))
       ((box-binding? b) `(box-ref ,(local-binding-operand b)))
       (else (binding-value b)))))

   (else
    (error 'compile-value "unknown form" expr))))


;; expr as the test of an if: and, or and not stay low's, which branch
(define (lower-test prog env expr)
  (cond
   ((and (special? env expr) (memq (car expr) '(and or)))
    (cons (car expr) (map-in-order (lambda (x) (lower-test prog env x)) (cdr expr))))

   ((and (special? env expr) (memq (car expr) '(let let* begin)))
    (lower-scope prog env expr lower-test))

   ((and (call? env expr)
         (= (length expr) 2)
         (primitive-named? env (car expr) 'scm-not))
    `(not ,(lower-test prog env (cadr expr))))

   (else
    (lower-value prog env expr))))


(define (primitive-named? env x low-name)
  (let ((entry (and (symbol? x) (assq x env))))
    (and entry
         (primitive-binding? (cdr entry))
         (eq? (procedure-binding-proc (cdr entry)) low-name))))


;; The value of the deciding operand
(define (lower-and prog env exprs)
  (cond
   ((null? exprs) #t)
   ((null? (cdr exprs)) (lower-value prog env (car exprs)))
   (else `(if ,(lower-test prog env (car exprs))
              ,(lower-and prog env (cdr exprs))
              #f))))


(define (lower-or prog env exprs)
  (cond
   ((null? exprs) #f)
   ((null? (cdr exprs)) (lower-value prog env (car exprs)))
   (else
    (let ((t (fresh-name prog 'or)))
      `(let ((,t ,(lower-value prog env (car exprs))))
         (if ,t ,t ,(lower-or prog env (cdr exprs))))))))


;; let, let* and begin, the last body expression by (lower-last prog env x)
(define (lower-scope prog env expr lower-last)
  (case (car expr)
    ((let)
     (let-values (((bindings body) (parse-let expr)))
       (let* ((vars (free-vars (bind-scope env (map car bindings)) body))
              (locals (map-in-order (lambda (b) (lower-local prog env (car b) (cadr b) vars))
                                    bindings)))
         `(let ,(map car locals)
            ,@(lower-body prog
                          (append (map cdr locals) env)
                          body lower-last)))))

    ((let*)
     (let-values (((bindings body) (parse-let* expr)))
       (let loop ((bindings bindings)
                  (env env)
                  (acc '()))
         (if (null? bindings)
             `(let* ,(reverse acc) ,@(lower-body prog env body lower-last))
             (let* ((var (caar bindings))
                    (vars (walk-let* (bind-scope env (list var)) (cdr bindings) body no-vars))
                    (local (lower-local prog env var (cadar bindings) vars)))
               (loop (cdr bindings) (cons (cdr local) env) (cons (car local) acc)))))))

    ((begin)
     `(begin ,@(lower-body prog env (parse-begin expr) lower-last)))))


;; A let variable var bound to init: ((name init) . (var . binding))
(define (lower-local prog env var init vars)
  (let* ((name (fresh-name prog var))
         (init (lower-named prog env var init)))
    (if (boxed? var vars)
        (cons `(,name (make-box ,init)) (cons var (make-box-binding name #t)))
        (cons `(,name ,init) (cons var (make-local-binding name #f))))))


(define (lower-body prog env exprs lower-last)
  (let-values (((init last) (split-last exprs)))
    (append (map-in-order (lambda (x) (lower-value prog env x)) init)
            (list (lower-last prog env last)))))


;; expr, naming it name if it is a lambda
(define (lower-named prog env name expr)
  (if (and (special? env expr)
           (eq? (car expr) 'lambda))
      (let-values (((args body) (parse-lambda expr)))
        (lower-procedure prog env name args body))
      (lower-value prog env expr)))


;; Lifts the procedure into a def and returns its value:
;; the def name, or a closure filled with the captures
(define (lower-procedure prog env name args body)
  (let ((def-name (fresh-name prog (or name 'lambda))))
    (lift-procedure! prog env def-name name args body)))


(define (lift-procedure! prog env def-name name args body)
  (let* ((captures (map (lambda (var) (assq var env))
                        (reverse (captured-vars env args body))))
         (outer-env (filter (lambda (b) (not (local-binding? (cdr b)))) env))
         (capture-names (map-in-order (lambda (c) (fresh-name prog (car c))) captures))
         (inner-env (append (map (lambda (c name) (cons (car c) (capture-binding name (cdr c))))
                                 captures capture-names)
                            outer-env))
         (params (map-in-order (lambda (x) (fresh-name prog x)) args))
         (vars (free-vars (bind-scope inner-env args) body))
         ;; (param . box name) of the boxed parameters
         (boxes (map-in-order (lambda (x) (cons (cdr x) (fresh-name prog (car x))))
                              (filter (lambda (x) (boxed? (car x) vars)) (map cons args params))))
         (body-env (append (map (lambda (x p)
                                  (cons x (let ((box (assq p boxes)))
                                            (if box
                                                (make-box-binding (cdr box) #t)
                                                (make-local-binding p #f)))))
                                args params)
                           inner-env))
         (body (lower-body prog body-env body lower-value))
         (body (if (null? boxes)
                   body
                   `((let ,(map (lambda (box) `(,(cdr box) (make-box ,(car box)))) boxes)
                       ,@body))))
         (body (if (null? captures)
                   body
                   `((let ,(map (lambda (name i) `(,name (closure-ref (raw ,i))))
                                capture-names (iota (length captures)))
                       ,@body))))
         (attrs `(,@(if name `((:as ,name)) '(:anonymous))
                  ,@(if (null? captures) '() `((:captures ,(length captures)))))))
    (hashtable-set! (low-program-arity prog) def-name (length args))
    (add-def! prog `(def ,def-name ,(map (lambda (p) `(val ,p)) params) -> (val) ,attrs
                         ,@body))
    (if (null? captures)
        def-name
        (let ((c (fresh-name prog 'closure)))
          `(let ((,c (alloc-closure ,def-name)))
             ,@(map (lambda (capture i)
                      `(closure-set! ,c (raw ,i) ,(local-binding-operand (cdr capture))))
                    captures (iota (length captures)))
             (as-val ,c))))))


(define (lower-set! prog env var expr)
  (let ((src (lower-named prog env var expr))
        (b (lookup-binding env var)))
    (cond
     ((box-binding? b)
      `(begin (box-set! ,(local-binding-operand b) ,src) undef))
     ((local-binding? b)
      `(begin (set! ,(local-binding-operand b) ,src) undef))
     ((global-binding? b)
      `(begin (global-set! (raw ,(global-binding-index b)) ,src) undef))
     (else
      (error 'compile-set! "set! of a prelude procedure or primitive" var)))))


(define (lower-call prog env form)
  (let ((entry (and (symbol? (car form)) (assq (car form) env)))
        (args (map-in-order (lambda (x) (lower-value prog env x)) (cdr form))))
    (if (and entry (primitive-binding? (cdr entry)))
        (begin
          (unless (= (length args) (procedure-binding-arity (cdr entry)))
            (error 'compile-primitive-call "wrong number of arguments" form))
          (cons (procedure-binding-proc (cdr entry)) args))
        (lower-apply prog (lower-value prog env (car form)) args))))


;; A def of the right arity is called directly, any other procedure value indirectly
(define (lower-apply prog op args)
  (let ((arity (and (symbol? op) (hashtable-ref (low-program-arity prog) op #f))))
    (if (and arity (not (= arity (length args))))
        (let ((p (fresh-name prog 'proc)))
          `(let ((,p ,op)) (,p ,@args)))
        (cons op args))))


;; The low defs of the prelude and the program, after (globals n)
(define (program->low prelude program)
  (when (null? program)
    (error 'program->ir "empty program"))
  (let* ((prog (make-low-program))
         (prelude-defs (scan-prelude prelude))
         (prelude-names (map-in-order (lambda (d) (fresh-name prog (prelude-def-name d)))
                                      prelude-defs))
         (env (append (map (lambda (p)
                             (cons (car p) (make-primitive-binding (cadr p) (caddr p))))
                           low-primitives)
                      (map (lambda (d name)
                             (cons (prelude-def-name d)
                                   (make-procedure-binding name (length (prelude-def-args d)))))
                           prelude-defs prelude-names))))
    (for-each (lambda (d name)
                (hashtable-set! (low-program-arity prog) name (length (prelude-def-args d))))
              prelude-defs prelude-names)
    (for-each (lambda (d name)
                (lift-procedure! prog env name (prelude-def-name d)
                                 (prelude-def-args d) (prelude-def-body d)))
              prelude-defs prelude-names)
    (let-values (((forms expr) (split-last program)))
      (let* ((globals (scan-defs forms make-global-def))
             (env (append (map (lambda (g)
                                 (cons (global-def-name g)
                                       (make-global-binding (global-def-index g))))
                               globals)
                          env))
             (inits (map-in-order (lambda (g)
                                    `(global-set! (raw ,(global-def-index g))
                                                  ,(lower-global prog env g)))
                                  globals))
             (main `(def main () -> (val) () ,@inits ,(lower-value prog env expr))))
        `((globals ,(length globals))
          ,@(reverse (low-program-defs prog))
          ,main)))))


(define (lower-global prog env g)
  (if (global-def-args g)
      (lower-procedure prog env (global-def-name g) (global-def-args g) (global-def-body g))
      (lower-named prog env (global-def-name g) (car (global-def-body g)))))


(parameterize ((print-brackets #f))
  (for-each pretty-print
            (program->low (with-input-from-file "prelude.ss" read-all) (read-all))))
