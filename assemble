#!/usr/bin/env -S scheme --program

;; ./assemble < DUMP > OBJ, DUMP being the output of `schemec --dump program` (or of
;; `--dump peephole`, the functions only): an ELF64 relocatable object, without GNU as.
;; Not used by the pipeline yet: asmcheck.py compares its output with the objects of GNU as,
;; toward IDEAS M52 and the JIT (JIT.md).
;;
;; The encoding is GNU as's, byte for byte:
;; - jumps to a label of the same section, even a global one, start short (rel8)
;;   and grow to rel32 until all fit (relaxation);
;; - disp8 when the displacement fits, none for 0 (but from rbp or r13);
;; - sign-extended imm8 when it fits, the short rax form for imm32, movabs
;;   only for a 64-bit immediate, immediates taken modulo 2^64 (so
;;   2^64 - 1 is -1);
;; - .balign in .text pads with GNU as's NOPs, zeros elsewhere.
;;
;; A reference to a local symbol of the same section is resolved, but an
;; absolute one, and so is a jmp to a global one (a call is not); the
;; others become relocations, against the symbol for a
;; global or undefined one, against the section otherwise (asmcheck.py
;; compares them in that form). Calls and jumps to a symbol use
;; R_X86_64_PLT32, RIP-relative operands R_X86_64_PC32, quads R_X86_64_64.
;;
;; The object has the sections of the dump, their type and flags from their
;; names (section-kinds), then their .rela sections, .symtab, .strtab and
;; .shstrtab.
;; The symbols: one per section, the labels but the .L ones (local), then the
;; defined globals and the undefined symbols.

(import (chezscheme))


;; x86-64 instruction encoding
;;
;; An instruction is, in order: prefixes (#xf3 for rep, #x66 in some NOPs), a
;; REX prefix, the opcode (1 byte, or 2 starting with #x0f), a ModRM byte, a
;; SIB byte, a displacement (1 or 4 bytes) and an immediate (1, 4 or 8
;; bytes), all but the opcode optional.
;; Multi-byte fields are little-endian.
;; Registers are numbered from 0 to 15: ModRM and SIB hold the low 3 bits of
;; a number, the REX prefix the fourth.


(define registers
  '((rax . 0) (rcx . 1) (rdx . 2) (rbx . 3) (rsp . 4) (rbp . 5) (rsi . 6) (rdi . 7)
    (r8 . 8) (r9 . 9) (r10 . 10) (r11 . 11) (r12 . 12) (r13 . 13) (r14 . 14) (r15 . 15)))


(define registers32
  '((eax . 0) (ecx . 1) (edx . 2) (ebx . 3) (esp . 4) (ebp . 5) (esi . 6) (edi . 7)
    (r8d . 8) (r9d . 9) (r10d . 10) (r11d . 11) (r12d . 12) (r13d . 13) (r14d . 14) (r15d . 15)))


;; Only those encoded the same with or without a REX prefix: 4 to 7 are ah to
;; bh without one, spl to dil with one
(define registers8
  '((al . 0) (cl . 1) (dl . 2) (bl . 3)))


;; The size of register x in bits, or #f
(define (reg-size x)
  (cond
   ((not (symbol? x)) #f)
   ((assq x registers) 64)
   ((assq x registers32) 32)
   ((assq x registers8) 8)
   (else #f)))


(define (reg-num r)
  (cond
   ((or (assq r registers) (assq r registers32) (assq r registers8)) => cdr)
   (else (error 'encode-asm "not a register" r))))


(define (reg? x)
  (and (reg-size x) #t))


(define (mem? x)
  (and (pair? x) (memq (car x) '(mem mem8 mem32 rip)) #t))


(define (s8? n)
  (<= -128 n 127))


(define (s32? n)
  (<= (- (expt 2 31)) n (- (expt 2 31) 1)))


;; n modulo 2^64, signed
(define (signed64 n)
  (let ((n (logand n (- (expt 2 64) 1))))
    (if (>= n (expt 2 63)) (- n (expt 2 64)) n)))


;; The size low bytes of n, little-endian
(define (le n size)
  (let loop ((i 0) (n n) (acc '()))
    (if (= i size)
        (reverse acc)
        (loop (+ i 1) (ash n -8) (cons (logand n 255) acc)))))


;; Encoded bytes, with fixups at offsets relative to the first byte
(define-record-type piece
  (fields bytes fixups))


;; type is abs64, pc32, plt32 or jmp32 (a plt32 resolved even for a global
;; symbol of the same section); the field holds symbol + addend - its own address
;; (pc32, plt32) or symbol + addend (abs64)
(define-record-type fixup
  (fields offset type symbol addend))


;; A jump to a local label of the same section, short until relaxed; cc is the
;; condition code, #f for jmp
(define-record-type jump
  (fields cc label (mutable long?)))


;; The low 4 bits of the opcodes of the conditional jumps: #x70 + cc with a
;; rel8, #x0f #x80 + cc with a rel32.
;; A short jmp is #xeb rel8, a long one #xe9 rel32; rel is from the end of the jump.
(define condition-codes
  '((jb . 2) (jae . 3) (je . 4) (jne . 5) (jbe . 6) (ja . 7)
    (jl . 12) (jge . 13) (jle . 14) (jg . 15)))


;; The REX prefix, #x40 to #x4f, of the bits W (8) for a 64-bit operation, then
;; the fourth bit of R (4) the ModRM reg, X (2) the SIB index and B (1) the
;; ModRM rm or SIB base.
;; It is left out when no bit is set.
(define (rex w r x b)
  (let ((bits (logior (if w 8 0)
                      (if (>= r 8) 4 0)
                      (if (>= x 8) 2 0)
                      (if (>= b 8) 1 0))))
    (if (= bits 0) '() (list (logior #x40 bits)))))


;; The ModRM byte: mod (2 bits), reg (3), rm (3).
;; reg is a register operand or, for an opcode of one operand, an extension of
;; the opcode (the /n of the manuals).
;; With mod 3, rm is a register; otherwise it is the base of a memory operand
;; followed by no displacement (mod 0), a disp8 (1) or a disp32 (2).
;; Two rm values are escapes: 4 for a SIB byte, so rsp and r12 as a base need one;
;; 5 with mod 0 for RIP-relative, so rbp and r13 as a base need a displacement.
(define (modrm mod reg rm)
  (+ (* mod 64) (* (logand reg 7) 8) (logand rm 7)))


;; The ModRM and what follows of the operand x, reg being the reg field:
;; (values index base bytes fixup), index and base for the REX prefix, fixup the
;; offset in bytes, symbol and offset of a RIP-relative operand, or #f.
;; The SIB byte: scale (2 bits, log2 of 1, 2, 4 or 8), index (3), base (3);
;; index 4 is none, so #x24 is rsp alone as the base.
(define (rm-bytes reg x)
  (cond
   ((reg? x)
    (values 0 (reg-num x) (list (modrm 3 reg (reg-num x))) #f))
   ((eq? (car x) 'rip)
    (values 0 0 (list (modrm 0 reg 5) 0 0 0 0)
            (list 1 (cadr x) (if (pair? (cddr x)) (caddr x) 0))))
   (else
    (let* ((base (reg-num (cadr x)))
           (index (and (pair? (cddr x)) (symbol? (caddr x)) (reg-num (caddr x))))
           (scale (if (pair? (cdddr x)) (cadddr x) 1))
           (disp (if (or index (null? (cddr x))) 0 (caddr x)))
           (mod (cond
                 ((and (= disp 0) (not (= (logand base 7) 5))) 0)
                 ((s8? disp) 1)
                 ((s32? disp) 2)
                 (else (error 'encode-asm "displacement too large" x))))
           (disp-bytes (case mod ((0) '()) ((1) (le disp 1)) (else (le disp 4)))))
      (cond
       (index
        (values index base
                `(,(modrm mod reg 4)
                  ,(+ (* 64 (case scale ((1) 0) ((2) 1) ((4) 2) ((8) 3)))
                      (* 8 (logand index 7))
                      (logand base 7))
                  ,@disp-bytes)
                #f))
       ((= (logand base 7) 4)
        (values 0 base `(,(modrm mod reg 4) #x24 ,@disp-bytes) #f))
       (else
        (values 0 base `(,(modrm mod reg base) ,@disp-bytes) #f)))))))


;; prefixes, REX, opcode, the operand x with reg in the reg field, imm: a piece;
;; w for a 64-bit operation.
;; A RIP-relative disp32 is from the end of the instruction, after the
;; immediate, hence the addend.
(define (op-rm prefixes w opcode reg x imm)
  (let-values (((index base bytes fixup) (rm-bytes reg x)))
    (let ((head (append prefixes (rex w reg index base) opcode)))
      (make-piece (append head bytes imm)
                  (if fixup
                      (list (make-fixup (+ (length head) (car fixup)) 'pc32 (cadr fixup)
                                        (- (caddr fixup) 4 (length imm))))
                      '())))))


(define (simple . bytes)
  (make-piece bytes '()))


(define (wide? x)
  (or (eq? (reg-size x) 64) (and (pair? x) (memq (car x) '(mem rip)) #t)))


;; #x89 is mov r/m, reg and #x8b mov reg, r/m (GNU as picks #x89 between
;; registers); #x88 is #x89 on bytes.
;; #xc7 /0 stores a sign-extended imm32 and #xc6 /0 an imm8.
;; #xb8 + r, the register in the opcode, loads an imm64 with REX.W (movabs),
;; an imm32 without, zero-extended.
(define (encode-mov dst src)
  (cond
   ((and (reg? dst) (reg? src))
    (op-rm '() (wide? dst) '(#x89) (reg-num src) dst '()))
   ((and (eq? (reg-size dst) 64) (integer? src))
    (if (s32? src)
        (op-rm '() #t '(#xc7) 0 dst (le src 4))
        (let ((r (reg-num dst)))
          (make-piece `(,@(rex #t 0 0 r) ,(+ #xb8 (logand r 7)) ,@(le src 8)) '()))))
   ((and (eq? (reg-size dst) 32) (integer? src))
    (let ((r (reg-num dst)))
      (make-piece `(,@(rex #f 0 0 r) ,(+ #xb8 (logand r 7)) ,@(le src 4)) '())))
   ((and (reg? dst) (mem? src))
    (op-rm '() (wide? dst) '(#x8b) (reg-num dst) src '()))
   ((and (mem? dst) (eq? (reg-size src) 8))
    (op-rm '() #f '(#x88) (reg-num src) dst '()))
   ((and (mem? dst) (reg? src))
    (op-rm '() (wide? src) '(#x89) (reg-num src) dst '()))
   ((and (mem? dst) (eq? (car dst) 'mem8) (integer? src))
    (op-rm '() #f '(#xc6) 0 dst (le src 1)))
   ((and (mem? dst) (integer? src) (s32? src))
    (op-rm '() (wide? dst) '(#xc7) 0 dst (le src 4)))
   (else
    (error 'encode-asm "unsupported mov" dst src))))


;; Group 1 operation n (add 0, or 1, and 4, sub 5, xor 6, cmp 7).
;; Its opcodes: 8n + 1 op r/m, reg; 8n + 3 op reg, r/m; 8n + 5 op rax, imm32,
;; without ModRM; #x81 /n with an imm32 and #x83 /n with a sign-extended imm8.
(define (encode-alu n dst src)
  (cond
   ((and (or (reg? dst) (mem? dst)) (reg? src))
    (op-rm '() (wide? dst) (list (+ (* n 8) 1)) (reg-num src) dst '()))
   ((and (reg? dst) (mem? src))
    (op-rm '() #t (list (+ (* n 8) 3)) (reg-num dst) src '()))
   ((and (integer? src) (s8? src))
    (op-rm '() (wide? dst) '(#x83) n dst (le src 1)))
   ((and (integer? src) (s32? src) (reg? dst) (= (reg-num dst) 0))
    (make-piece `(,@(rex (wide? dst) 0 0 0) ,(+ (* n 8) 5) ,@(le src 4)) '()))
   ((and (integer? src) (s32? src))
    (op-rm '() (wide? dst) '(#x81) n dst (le src 4)))
   (else
    (error 'encode-asm "unsupported operands" n dst src))))


;; Shift n (shl/sal 4, shr 5, sar 7) by cl or an immediate: #xd3 /n by cl,
;; #xd1 /n by 1, #xc1 /n by an imm8
(define (encode-shift n dst count)
  (cond
   ((eq? count 'cl) (op-rm '() (wide? dst) '(#xd3) n dst '()))
   ((eqv? count 1) (op-rm '() (wide? dst) '(#xd1) n dst '()))
   ((integer? count) (op-rm '() (wide? dst) '(#xc1) n dst (le count 1)))
   (else (error 'encode-asm "unsupported shift count" count))))


;; A call or a jmp: through a register, a relaxable jump to a local label, or a
;; rel32 to a symbol, resolved later if it is local.
;; #xff /2 is call r/m and #xff /4 jmp r/m; #xe8 is call rel32 and #xe9 jmp
;; rel32, from the end of the instruction (hence the addend -4).
(define (encode-transfer op target local?)
  (cond
   ((reg? target)
    (op-rm '() #f '(#xff) (if (eq? op 'call) 2 4) target '()))
   ((and (eq? op 'jmp) (local? target))
    (make-jump #f target #f))
   (else
    (make-piece (list (if (eq? op 'call) #xe8 #xe9) 0 0 0 0)
                (list (make-fixup 1 (if (eq? op 'call) 'plt32 'jmp32) target -4))))))


;; local? tells whether a symbol is a label of the current section:
;; a piece or a jump.
;; The other opcodes: movzx #x0f #xb6 (from a byte), lea #x8d, imul #x0f #xaf
;; reg, r/m and #x6b or #x69 reg, r/m, imm8 or imm32; mul, div and idiv #xf7
;; /4, /6 and /7; push and pop #x50 and #x58 + r, push #xff /6 r/m, #x6a imm8
;; and #x68 imm32.
(define (encode instr local?)
  (let ((op (car instr))
        (args (map (lambda (x) (if (integer? x) (signed64 x) x)) (cdr instr))))
    (case op
      ((mov) (encode-mov (car args) (cadr args)))
      ((movzx) (op-rm '() (wide? (car args)) '(#x0f #xb6) (reg-num (car args)) (cadr args) '()))
      ((lea) (op-rm '() #t '(#x8d) (reg-num (car args)) (cadr args) '()))
      ((add) (encode-alu 0 (car args) (cadr args)))
      ((or) (encode-alu 1 (car args) (cadr args)))
      ((and) (encode-alu 4 (car args) (cadr args)))
      ((sub) (encode-alu 5 (car args) (cadr args)))
      ((xor) (encode-alu 6 (car args) (cadr args)))
      ((cmp) (encode-alu 7 (car args) (cadr args)))
      ((imul)
       (let ((reg (reg-num (car args))))
         (cond
          ((null? (cddr args)) (op-rm '() #t '(#x0f #xaf) reg (cadr args) '()))
          ((s8? (caddr args)) (op-rm '() #t '(#x6b) reg (cadr args) (le (caddr args) 1)))
          (else (op-rm '() #t '(#x69) reg (cadr args) (le (caddr args) 4))))))
      ((sal shl) (encode-shift 4 (car args) (cadr args)))
      ((shr) (encode-shift 5 (car args) (cadr args)))
      ((sar) (encode-shift 7 (car args) (cadr args)))
      ((mul) (op-rm '() #t '(#xf7) 4 (car args) '()))
      ((div) (op-rm '() #t '(#xf7) 6 (car args) '()))
      ((idiv) (op-rm '() #t '(#xf7) 7 (car args) '()))
      ((cqo) (simple #x48 #x99))
      ((push pop)
       (let ((x (car args)))
         (cond
          ((reg? x)
           (let ((r (reg-num x)))
             (make-piece `(,@(rex #f 0 0 r) ,(+ (if (eq? op 'push) #x50 #x58) (logand r 7))) '())))
          ((and (eq? op 'push) (mem? x)) (op-rm '() #f '(#xff) 6 x '()))
          ((and (eq? op 'push) (integer? x) (s8? x)) (simple #x6a (logand x 255)))
          ((and (eq? op 'push) (integer? x) (s32? x)) (make-piece (cons #x68 (le x 4)) '()))
          (else (error 'encode-asm "unsupported instruction" instr)))))
      ((call jmp) (encode-transfer op (car args) local?))
      ((je jne jl jle jg jge jb jbe ja jae)
       (unless (local? (car args))
         (error 'encode-asm "conditional jump to a symbol of another section" instr))
       (make-jump (cdr (assq op condition-codes)) (car args) #f))
      ((leave) (simple #xc9))
      ((ret) (simple #xc3))
      ((syscall) (simple #x0f #x05))
      ((ud2) (simple #x0f #x0b))
      ((rep)
       (case (car args)
         ((movsq) (simple #xf3 #x48 #xa5))
         ((stosq) (simple #xf3 #x48 #xab))
         (else (error 'encode-asm "unsupported instruction" instr))))
      (else
       (error 'encode-asm "unsupported instruction" instr)))))


(define (quad-piece xs)
  (make-piece (apply append (map (lambda (x) (le (if (string? x) 0 x) 8)) xs))
              (let loop ((xs xs) (offset 0) (acc '()))
                (cond
                 ((null? xs) (reverse acc))
                 ((string? (car xs))
                  (loop (cdr xs) (+ offset 8) (cons (make-fixup offset 'abs64 (car xs) 0) acc)))
                 (else (loop (cdr xs) (+ offset 8) acc))))))


(define (asciz-piece s)
  (make-piece (append (bytevector->u8-list (string->utf8 s)) '(0)) '()))


;; GNU as's NOPs for padding code, by length
(define nops
  '#((#x90)
     (#x66 #x90)
     (#x0f #x1f #x00)
     (#x0f #x1f #x40 #x00)
     (#x0f #x1f #x44 #x00 #x00)
     (#x66 #x0f #x1f #x44 #x00 #x00)
     (#x0f #x1f #x80 #x00 #x00 #x00 #x00)
     (#x0f #x1f #x84 #x00 #x00 #x00 #x00 #x00)))


(define (padding n text?)
  (cond
   ((= n 0) '())
   ((not text?) (make-list n 0))
   ((<= n 8) (vector-ref nops (- n 1)))
   (else (append (vector-ref nops 7) (padding (- n 8) text?)))))


;; The items of a section: pieces, jumps, (label name) and (align n)
(define (item-size item offset)
  (cond
   ((piece? item) (length (piece-bytes item)))
   ((jump? item) (cond
                  ((not (jump-long? item)) 2)
                  ((jump-cc item) 6)
                  (else 5)))
   ((eq? (car item) 'label) 0)
   (else (modulo (- offset) (cadr item)))))


(define (label? item)
  (and (pair? item) (eq? (car item) 'label)))


(define (align? item)
  (and (pair? item) (eq? (car item) 'align)))


;; The offset of each item, and the size of them all
(define (item-offsets items)
  (let loop ((items items) (offset 0) (acc '()))
    (if (null? items)
        (values (reverse acc) offset)
        (loop (cdr items) (+ offset (item-size (car items) offset)) (cons offset acc)))))


;; Grows short jumps until they all fit: (values labels size), labels being a
;; hashtable from name to offset.
;; As in GNU as, a pass sees the labels it has passed at their new offsets.
;; A label ahead is assumed to have moved as much as the jump, unless an
;; alignment between them may absorb it: then it is at its old offset.
(define (layout! items)
  (let loop ()
    (let-values (((old size) (item-offsets items)))
      (let ((ahead (make-hashtable string-hash string=?))
            (passed (make-hashtable string-hash string=?))
            (changed #f))
        ;; Regions are separated by alignments
        (fold-left (lambda (region item offset)
                     (when (label? item)
                       (hashtable-set! ahead (cadr item) (cons offset region)))
                     (if (align? item) (+ region 1) region))
                   0 items old)
        (let walk ((items items) (old old) (offset 0) (region 0))
          (unless (null? items)
            (let ((item (car items)))
              (when (label? item)
                (hashtable-set! passed (cadr item) offset))
              (when (and (jump? item) (not (jump-long? item)))
                (let* ((name (jump-label item))
                       (x (hashtable-ref ahead name #f))
                       ;; #f: a label past an alignment now behind, left short until the next pass
                       (target (cond
                                ((hashtable-ref passed name #f) => values)
                                ((= (cdr x) region) (+ (car x) (- offset (car old))))
                                ((< (car x) offset) #f)
                                (else (car x)))))
                  (unless (or (not target) (s8? (- target offset 2)))
                    (jump-long?-set! item #t)
                    (set! changed #t))))
              (walk (cdr items) (cdr old) (+ offset (item-size item offset))
                    (if (align? item) (+ region 1) region)))))
        (if changed
            (loop)
            (let ((labels (make-hashtable string-hash string=?)))
              (for-each (lambda (item offset)
                          (when (label? item)
                            (hashtable-set! labels (cadr item) offset)))
                        items old)
              (values labels size)))))))


(define (bytevector-put! bv offset bytes)
  (for-each (lambda (b i) (bytevector-u8-set! bv (+ offset i) b))
            bytes (iota (length bytes))))


;; (values bytevector labels fixups), fixups being (offset . fixup), offsets
;; from the start of the section
(define (assemble-section items text?)
  (let-values (((labels size) (layout! items)))
    (let ((bv (make-bytevector size 0))
          (fixups '()))
      (fold-left
       (lambda (offset item)
         (let ((next (+ offset (item-size item offset))))
           (cond
            ((piece? item)
             (bytevector-put! bv offset (piece-bytes item))
             (for-each (lambda (f)
                         (set! fixups (cons (cons (+ offset (fixup-offset f)) f) fixups)))
                       (piece-fixups item)))
            ((jump? item)
             (let ((disp (- (hashtable-ref labels (jump-label item) #f) next))
                   (cc (jump-cc item)))
               (bytevector-put! bv offset
                                (cond
                                 ((not (jump-long? item)) (list (if cc (+ #x70 cc) #xeb) (logand disp 255)))
                                 (cc `(#x0f ,(+ #x80 cc) ,@(le disp 4)))
                                 (else `(#xe9 ,@(le disp 4)))))))
            ((eq? (car item) 'align)
             (bytevector-put! bv offset (padding (- next offset) text?))))
           next))
       0 items)
      (values bv labels (reverse fixups)))))


(define (reloc-type type)
  (case type
    ((abs64) 1)
    ((pc32) 2)
    ((plt32 jmp32) 4)))


;; The largest .balign of a section's items, at least 1
(define (alignment items)
  (fold-left (lambda (a item) (if (align? item) (max a (cadr item)) a)) 1 items))


;; Labels left out of the symbol table, as GNU as does
(define (local-label? name)
  (and (>= (string-length name) 2) (string=? (substring name 0 2) ".L")))


;; ELF64 relocatable objects
;;
;; The file is a 64-byte ELF header, the contents of the sections, then the
;; section header table, of 64-byte entries.
;; Entry 0 is null, index 0 meaning no section, so the sections are numbered
;; from 1.
;; A section header: name, type, flags, address (0 in an object), file offset,
;; size, link, info, alignment and entry size (of a table, else 0); link and
;; info depend on the type.
;; The names are offsets in .shstrtab, a string table the ELF header gives the
;; index of.
;; A string table is the names, each followed by a 0 byte, after a 0 byte,
;; offset 0 being the empty name.
;;
;; .symtab is an array of 24-byte symbols: name (an offset in .strtab), info,
;; other (the visibility, 0 the default), section index (0 undefined), value
;; (an offset in the section) and size.
;; info is the binding (0 local, 1 global) * 16 + the type (0 none, 3 section).
;; Entry 0 is null, then come the locals: the header's info is the index of
;; the first global, its link that of .strtab.
;;
;; .rela.X holds the relocations of section X, of 24 bytes: offset in X, info
;; (the symbol's index * 2^32 + the type) and addend.
;; Its link is the index of .symtab, its info that of X (flag #x40, SHF_INFO_LINK).
;; For each type, the linker stores at the offset: S + A for R_X86_64_64 (1),
;; S + A - P for R_X86_64_PC32 (2) and L + A - P for R_X86_64_PLT32 (4), S
;; being the symbol's address, A the addend, P the address of the offset and L
;; that of the symbol's PLT entry, or of the symbol when there is none.
;; A relocation to a local label is against its section's symbol, the label's
;; offset added to the addend.


;; A little-endian bytevector of the fields: size n ..., n taken modulo 2^(8 size)
(define (pack . fields)
  (let ((bv (make-bytevector (let loop ((l fields)) (if (null? l) 0 (+ (car l) (loop (cddr l))))))))
    (let loop ((l fields) (offset 0))
      (unless (null? l)
        (bytevector-uint-set! bv offset (logand (cadr l) (- (expt 2 (* 8 (car l))) 1)) 'little (car l))
        (loop (cddr l) (+ offset (car l)))))
    bv))


(define (bytevector-concat bvs)
  (let-values (((port get) (open-bytevector-output-port)))
    (for-each (lambda (bv) (put-bytevector port bv)) bvs)
    (get)))


;; A string table: (values add! contents), add! giving the offset of a name, contents
;; the table once all are added
(define (string-table)
  (let ((offsets (make-hashtable string-hash string=?))
        (names '())
        (size 1))
    (values
     (lambda (name)
       (or (hashtable-ref offsets name #f)
           (let ((offset size))
             (hashtable-set! offsets name offset)
             (set! names (cons name names))
             (set! size (+ offset (bytevector-length (string->utf8 name)) 1))
             offset)))
     (lambda ()
       (bytevector-concat (cons (bytevector 0)
                                (map (lambda (name) (bytevector-concat (list (string->utf8 name) (bytevector 0))))
                                     (reverse names))))))))


(define sht-progbits 1)
(define sht-symtab 2)
(define sht-strtab 3)
(define sht-rela 4)


;; The type and flags of the sections the compiler emits (flags: 1 write, 2 alloc, 4 exec).
;; The empty .note.GNU-stack asks for a non-executable stack.
(define section-kinds
  `((".text" ,sht-progbits 6)
    (".data" ,sht-progbits 3)
    (".data.rel.ro" ,sht-progbits 3)
    (".rodata" ,sht-progbits 2)
    (".note.GNU-stack" ,sht-progbits 0)))


(define-record-type elf-section
  (fields name type flags link info align entsize bytes))


(define (align-up n a)
  (* a (quotient (+ n a -1) a)))


;; An ELF64 relocatable object for x86-64 of the sections, at indices from 1, and
;; .shstrtab after them
(define (elf-object sections)
  (let-values (((name-offset names) (string-table)))
    (for-each (lambda (s) (name-offset (elf-section-name s))) sections)
    (name-offset ".shstrtab")
    (let* ((sections (append sections (list (make-elf-section ".shstrtab" sht-strtab 0 0 0 1 0 (names)))))
           (offsets (let loop ((l sections) (end 64))
                      (if (null? l)
                          (list end)
                          (let ((offset (align-up end (elf-section-align (car l)))))
                            (cons offset
                                  (loop (cdr l) (+ offset (bytevector-length (elf-section-bytes (car l))))))))))
           (shoff (align-up (list-ref offsets (length sections)) 8))
           (shnum (+ (length sections) 1)))
      (let-values (((port get) (open-bytevector-output-port)))
        ;; Magic, 64-bit, little-endian, version 1, System V ABI, padding; type ET_REL,
        ;; machine EM_X86_64, version, entry, program header offset (none), section
        ;; header offset, flags, header size, program header entry size and count,
        ;; section header entry size and count, index of .shstrtab
        (put-bytevector port (pack 4 #x464c457f 1 2 1 1 1 1 1 0 8 0
                                   2 1 2 62 4 1 8 0 8 0 8 shoff 4 0
                                   2 64 2 0 2 0 2 64 2 shnum 2 (- shnum 1)))
        (fold-left (lambda (end s offset)
                     (put-bytevector port (make-bytevector (- offset end) 0))
                     (put-bytevector port (elf-section-bytes s))
                     (+ offset (bytevector-length (elf-section-bytes s))))
                   64 sections (list-head offsets (length sections)))
        (put-bytevector port (make-bytevector (- shoff (list-ref offsets (length sections))) 0))
        (put-bytevector port (make-bytevector 64 0))
        ;; The section headers
        (for-each (lambda (s offset)
                    (put-bytevector port (pack 4 (name-offset (elf-section-name s)) 4 (elf-section-type s)
                                               8 (elf-section-flags s) 8 0 8 offset
                                               8 (bytevector-length (elf-section-bytes s))
                                               4 (elf-section-link s) 4 (elf-section-info s)
                                               8 (elf-section-align s) 8 (elf-section-entsize s))))
                  sections (list-head offsets (length sections)))
        (get)))))


;; The section of each label, and the global names
(define (scan-labels asm)
  (let ((sections (make-hashtable string-hash string=?))
        (globals (make-hashtable string-hash string=?))
        (current #f))
    (for-each (lambda (x)
                (case (car x)
                  ((text) (set! current ".text"))
                  ((section) (set! current (cadr x)))
                  ((globl) (hashtable-set! globals (cadr x) #t))
                  ((label)
                   (when (hashtable-contains? sections (cadr x))
                     (error 'encode-asm "duplicate label" (cadr x)))
                   (hashtable-set! sections (cadr x) current))))
              asm)
    (values sections globals)))


;; The asm s-expressions asm: an ELF object (see above)
(define (encode-asm asm)
  (let-values (((label-sections globals) (scan-labels asm)))
    (let ((names '())
          (items (make-hashtable string-hash string=?))
          (current #f))
      (define (local? name current)
        (and (string? name)
             (equal? (hashtable-ref label-sections name #f) current)))
      (define (add! item)
        (unless current
          (error 'encode-asm "code outside of a section" item))
        (hashtable-update! items current (lambda (l) (cons item l)) '()))
      (define (enter! name)
        (unless (member name names)
          (set! names (append names (list name))))
        (set! current name))
      (for-each
       (lambda (x)
         (case (car x)
           ((intel_syntax globl) #f)
           ((text) (enter! ".text"))
           ((section) (enter! (cadr x)))
           ((label) (add! x))
           ((balign) (add! (list 'align (cadr x))))
           ((quad) (add! (quad-piece (cdr x))))
           ((asciz) (add! (asciz-piece (cadr x))))
           (else (let ((section current))
                   (add! (encode x (lambda (name) (local? name section))))))))
       asm)
      (let* ((sections names)
             (section-items (map (lambda (name) (reverse (hashtable-ref items name '()))) sections))
             (assembled (map (lambda (name items)
                               (call-with-values
                                   (lambda () (assemble-section items (string=? name ".text")))
                                 list))
                             sections section-items))
             (relocs '()))
        (define (section-index name)
          (let loop ((l sections) (i 0))
            (cond
             ((null? l) #f)
             ((string=? (car l) name) i)
             (else (loop (cdr l) (+ i 1))))))
        ;; (section-index . offset) of a defined label, or #f
        (define (lookup name)
          (let ((s (hashtable-ref label-sections name #f)))
            (and s (section-index s)
                 (cons (section-index s) (hashtable-ref (cadr (list-ref assembled (section-index s))) name #f)))))
        ;; Adds to relocs (section offset type target addend), target a section index or a name
        (define (resolve! section entry)
          (let* ((offset (car entry))
                 (f (cdr entry))
                 (name (fixup-symbol f))
                 (def (and (or (eq? (fixup-type f) 'jmp32) (not (hashtable-contains? globals name)))
                           (lookup name))))
            (cond
             ((and def (= (car def) section) (not (eq? (fixup-type f) 'abs64)))
              (bytevector-s32-set! (car (list-ref assembled section)) offset
                                   (+ (cdr def) (fixup-addend f) (- offset)) 'little))
             (def
              (set! relocs (cons (list section offset (reloc-type (fixup-type f))
                                       (car def) (+ (cdr def) (fixup-addend f)))
                                 relocs)))
             (else
              (set! relocs (cons (list section offset (reloc-type (fixup-type f)) name (fixup-addend f))
                                 relocs))))))
        (for-each (lambda (a i) (for-each (lambda (e) (resolve! i e)) (caddr a)))
                  assembled (iota (length sections)))
        (set! relocs (reverse relocs))
        ;; Symbols: (name section-index . offset)
        (let* ((n (length sections))
               (defined (lambda (names) (filter cdr (map (lambda (name) (cons name (lookup name))) names))))
               (locals (list-sort (lambda (a b)
                                    (or (< (cadr a) (cadr b))
                                        (and (= (cadr a) (cadr b)) (< (cddr a) (cddr b)))))
                                  (defined (filter (lambda (name)
                                                     (not (or (hashtable-contains? globals name)
                                                              (local-label? name))))
                                                   (vector->list (hashtable-keys label-sections))))))
               (exported (defined (list-sort string<? (vector->list (hashtable-keys globals)))))
               (undefined (list-sort string<?
                                     (fold-left (lambda (acc r)
                                                  (let ((name (cadddr r)))
                                                    (if (or (not (string? name))
                                                            (assoc name exported)
                                                            (member name acc))
                                                        acc
                                                        (cons name acc))))
                                                '() relocs)))
               (first-global (+ 1 n (length locals)))
               (symbol-indices (make-hashtable string-hash string=?))
               (with-relocs (filter (lambda (i) (exists (lambda (r) (= (car r) i)) relocs)) (iota n)))
               (symtab-index (+ n (length with-relocs) 1)))
          (for-each (lambda (name i) (hashtable-set! symbol-indices name (+ first-global i)))
                    (append (map car exported) undefined) (iota (+ (length exported) (length undefined))))
          (let-values (((name-offset names) (string-table)))
            (define (sym name info shndx value)
              (pack 4 (if name (name-offset name) 0) 1 info 1 0 2 shndx 8 value 8 0))
            ;; The symbol of section i is at index i + 1, as the section
            (define (rela r)
              (let ((target (cadddr r)))
                (pack 8 (cadr r)
                      8 (+ (* (if (string? target) (hashtable-ref symbol-indices target #f) (+ target 1))
                              (expt 2 32))
                           (caddr r))
                      8 (car (cddddr r)))))
            (let* ((program (map (lambda (name a items)
                                   (let ((kind (or (assoc name section-kinds)
                                                   (error 'encode-asm "unknown section" name))))
                                     (make-elf-section name (cadr kind) (caddr kind) 0 0 (alignment items) 0
                                                       (car a))))
                                 sections assembled section-items))
                   (rela-sections
                    (map (lambda (i)
                           (make-elf-section (string-append ".rela" (list-ref sections i))
                                             sht-rela #x40 symtab-index (+ i 1) 8 24
                                             (bytevector-concat
                                              (map rela (filter (lambda (r) (= (car r) i)) relocs)))))
                         with-relocs))
                   ;; Local (bind 0) section symbols (type 3) and labels, then the globals (bind 1)
                   (symtab (bytevector-concat
                            (append (list (sym #f 0 0 0))
                                    (map (lambda (i) (sym #f 3 (+ i 1) 0)) (iota n))
                                    (map (lambda (s) (sym (car s) 0 (+ (cadr s) 1) (cddr s))) locals)
                                    (map (lambda (s) (sym (car s) #x10 (+ (cadr s) 1) (cddr s))) exported)
                                    (map (lambda (name) (sym name #x10 0 0)) undefined)))))
              (elf-object (append program
                                  rela-sections
                                  (list (make-elf-section ".symtab" sht-symtab 0 (+ symtab-index 1)
                                                          first-global 8 24 symtab)
                                        (make-elf-section ".strtab" sht-strtab 0 0 0 1 0 (names))))))))))))


;; The asm s-expressions of a dump, (program asm ...) or (function name asm ...), in order
(define (read-asm)
  (let loop ((acc '()))
    (let ((x (read)))
      (cond
       ((eof-object? x) (apply append (reverse acc)))
       ((and (pair? x) (eq? (car x) 'program))
        (loop (cons (cdr x) acc)))
       ((and (pair? x) (eq? (car x) 'function) (pair? (cdr x)))
        (loop (cons (cddr x) acc)))
       (else (errorf 'assemble "not a dumped program or function: ~s" x))))))


(let ((port (standard-output-port)))
  (put-bytevector port (encode-asm (read-asm)))
  (flush-output-port port))
