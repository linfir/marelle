;; Relocations while every allocation collects: each vector grows by relocating to a copy
;; one longer, and the references held in a list and a closure follow
(define (grow! v)
  (declare unsafe)
  (let* ((old (resolve v))
         (n (vector-length old))
         (new (make-vector (+ n 1) n)))
    (let copy ((i 0))
      (when (< i n)
        (vector-set! new i (vector-ref (resolve v) i))
        (copy (+ i 1))))
    (relocate! (resolve v) new)
    undef))
(define (body x)
  (declare unsafe)
  (resolve x))

(define v (vector 0))
(define held (list v v))
(define get (lambda () v))
(let loop ((i 0))
  (when (< i 20)
    (grow! v)
    (loop (+ i 1))))
(list (vector-length (body (car held))) (eq? (body (get)) (body (cadr held))) (body v))
