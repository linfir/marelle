;; Writes past the buffer, read back in several chunks
(define p (open-file-output-port "big.bin"))
(do ((i 0 (+ i 1)))
    ((= i 20000))
  (put-u8 p (modulo i 251)))
(put-bytevector p (make-bytevector 30000 7))
(put-u8 p 9)
(close-port p)
(define bv (call-with-port (open-file-input-port "big.bin") get-bytevector-all))
(list (bytevector-length bv)
      (bytevector-u8-ref bv 0)
      (bytevector-u8-ref bv 19999)
      (bytevector-u8-ref bv 20000)
      (bytevector-u8-ref bv 50000))
