(define p (open-file-output-port "out.bin"))
(put-u8 p 65)
(put-bytevector p #vu8(66 67 68 69))
(put-bytevector p #vu8(66 67 68 69) 2)
(put-bytevector p #vu8(66 67 68 69) 1 2)
(put-bytevector p #vu8(1 2) 2)
(close-port p)
(define i (open-file-input-port "out.bin"))
(let* ((a (get-u8 i))
       (b (get-bytevector-all i))
       (c (get-bytevector-all i))
       (d (get-u8 i)))
  (close-port i)
  (list a b c d))
