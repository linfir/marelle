;; Literal pairs, immutable, behave as data: shared, compared, appended to, hashed and printed
(define (f) '(1 (2 "three") #(4) . 5))
(define t (make-eq-hashtable))
(define e (make-hashtable equal-hash equal?))
(hashtable-set! t (f) 'eq)
(hashtable-set! e '(a b) 'equal)
(let loop ((i 0) (keep '()))
  (when (< i 10000)
    (loop (+ i 1) (cons i (if (pair? keep) (cdr keep) keep)))))
(define g (append (list 0) (cdr '(9 a b))))
(set-car! g 'z)
(list (f) (pair? (f)) (eq? (f) (f)) (cadr (f)) (cdddr (f))
      (equal? (f) (cons* 1 (list 2 "three") (vector 4) 5))
      (hashtable-ref t (f) #f) (hashtable-ref e (list 'a 'b) #f)
      g `(x ,@'(y z)) (list? '(1 2)) (length '(1 2 3)))
