(define (check a b)
  (let ((p (* a b)))
    (and (= (quotient p b) a)
         (= (modulo p b) 0)
         (= (* (+ a b) (+ a b)) (+ (* a a) (* 2 p) (* b b))))))
(define a (- (expt 3 5000) 1))
(define b (+ (expt 7 3000) 12345))
(define c (- (expt 2 1600) 1))
(define d (expt 5 900))
(list (check a b) (check b a) (check a c) (check c c) (check (- 0 a) d) (check a 3)
      (check (* a b) (* c d)) (check (expt a 3) b))
