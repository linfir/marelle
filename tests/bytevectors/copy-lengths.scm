;; Copies of every length to 20 between offsets to 9, across two bytevectors and within one
;; (overlapping both ways), against a byte loop: the count of mismatches
(define (pattern n)
  (let ((b (make-bytevector n 0)))
    (do ((i 0 (+ i 1))) ((= i n) b)
      (bytevector-u8-set! b i (modulo (+ (* 7 i) 3) 256)))))
(define (reference! to at from start end)
  (do ((i start (+ i 1))) ((= i end))
    (bytevector-u8-set! to (+ at (- i start)) (bytevector-u8-ref from i))))
(let ((bad 0))
  (do ((n 0 (+ n 1))) ((> n 20))
    (do ((src 0 (+ src 1))) ((> src 9))
      (do ((dst 0 (+ dst 1))) ((> dst 9))
        (let ((b (make-bytevector 40 0))
              (r (make-bytevector 40 0)))
          (bytevector-copy! b dst (pattern 40) src (+ src n))
          (reference! r dst (pattern 40) src (+ src n))
          (unless (equal? b r) (set! bad (+ bad 1))))
        (let ((a (pattern 40))
              (r (pattern 40)))
          (bytevector-copy! a dst a src (+ src n))
          (reference! r dst (pattern 40) src (+ src n))
          (unless (equal? a r) (set! bad (+ bad 1)))))))
  bad)
