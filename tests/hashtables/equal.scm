(define t (make-hashtable equal-hash equal?))
(hashtable-set! t (list 1 2 (vector 'a "b")) 'list)
(hashtable-set! t "abc" 'string)
(hashtable-set! t 12345678901234567890 'big)
(list (hashtable-ref t (list 1 2 (vector 'a "b")) #f)
      (hashtable-ref t (string #\a #\b #\c) #f)
      (hashtable-ref t (+ 12345678901234567889 1) #f)
      (hashtable-ref t (list 1 2) #f)
      t)
