(define t (make-hashtable equal-hash equal?))
(define (fill i)
  (when (< i 100)
    (hashtable-set! t (list i) i)
    (fill (+ i 1))))
(define (drop i)
  (when (< i 50)
    (hashtable-delete! t (list i))
    (drop (+ i 1))))
(define (sum i acc)
  (if (= i 100)
      acc
      (sum (+ i 1) (+ acc (hashtable-ref t (list i) 0)))))
(fill 0)
(drop 0)
(list (hashtable-size t) (sum 0 0))
