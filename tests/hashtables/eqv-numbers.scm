(define t (make-eqv-hashtable))
(define big (* 1000000000000 1000000000000))
(hashtable-set! t big 'big)
(hashtable-set! t (- big) 'negative)
(hashtable-set! t (/ 1 3) 'third)
(hashtable-set! t 7 'seven)
(define e (make-eq-hashtable))
(hashtable-set! e big 1)
(list (hashtable-ref t (* 1000000 1000000 1000000 1000000) #f)
      (hashtable-ref t (- 0 (* 1000000 1000000 1000000 1000000)) #f)
      (hashtable-ref t (/ 2 6) #f)
      (hashtable-ref t (/ 2 3) #f)
      (hashtable-ref t 7 #f)
      (hashtable-ref e (* 1000000 1000000 1000000 1000000) 'eq))
