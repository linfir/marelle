(define t (make-eq-hashtable))
(hashtable-set! t 'a 1)
(hashtable-set! t 5 2)
(hashtable-set! t #f 3)
(hashtable-set! t '() 4)
(hashtable-set! t #\x 5)
(hashtable-set! t 'a 6)
(list (hashtable-ref t 'a 0) (hashtable-ref t 5 0) (hashtable-ref t #f 0)
      (hashtable-ref t '() 0) (hashtable-ref t #\x 0) (hashtable-ref t 'b 'none)
      (hashtable-size t))
