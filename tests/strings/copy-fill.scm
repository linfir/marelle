;; string-copy, string-fill! and string-copy! with their optional ranges; a char or a range
;; that does not fit an ASCII string relocates it to UTF-32, keeping its identity
(define (fresh x) (string-append x ""))
(define a (fresh "abcdef"))
(define held (list a))
(string-fill! a #\x 4)
(string-fill! a #\é 0 1)
(define b (fresh "aéb"))
(string-fill! b #\z)
(define c (fresh "abcdef"))
(string-copy! c 2 c 0 4)
(define d (fresh "abcdef"))
(string-copy! d 0 d 2)
(define e (fresh "λabcdef"))
(string-copy! e 2 e 1 5)
(define f (fresh "abcd"))
(string-copy! f 1 "xλy" 0 2)
(define g (fresh "abcd"))
(string-copy! g 1 "éxy" 1)
(list (string-copy "hello") (string-copy "hello" 2) (string-copy "hλllo" 1 3)
      a (car held) (eq? a (car held)) b c d e f g)
