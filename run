#!/usr/bin/env -S scheme --libdirs compiler::build/chez --program

;; Run from the project root; compile and asm in one process.
;; ./run --lib DIR: the library, lib/*.ss, into DIR/lib.s and the interface DIR/lib.scm
;; ./run < SOURCE > ASM: a program, against build/lib.scm

(import (chezscheme)
        (utils)
        (library)
        (asm))


;; Locals and the markers are gensyms: errors print their names
(print-gensym #f)


;; The forms of lib/*.ss, in file name order
(define (library-forms)
  (apply append
         (map (lambda (name) (with-input-from-file (string-append "lib/" name) read-all))
              (sort string<?
                    (filter (lambda (name)
                              (let ((n (string-length name)))
                                (and (> n 3) (string=? (substring name (- n 3) n) ".ss"))))
                            (directory-list "lib"))))))


(define (stage f input)
  (with-input-from-string input
    (lambda ()
      (with-output-to-string
        (lambda () (f (read-all)))))))


(define (write-file path text)
  (call-with-port (open-file-output-port path (file-options no-fail) (buffer-mode block)
                                         (native-transcoder))
    (lambda (port) (put-string port text))))


(let ((args (cdr (command-line))))
  (if (and (pair? args) (string=? (car args) "--lib"))
      (let* ((interface #f)
             (ir (with-output-to-string
                   (lambda ()
                     (set! interface (compile-scheme-library (library-forms)))))))
        (write-file (string-append (cadr args) "/lib.scm")
                    (with-output-to-string
                      (lambda ()
                        (parameterize ((print-brackets #f))
                          (for-each pretty-print interface)))))
        (write-file (string-append (cadr args) "/lib.s") (stage compile-asm ir)))
      (let* ((source (let ((s (get-string-all (current-input-port))))
                       (if (eof-object? s) "" s)))
             (interface (with-input-from-file "build/lib.scm" read-all))
             (ir (stage (lambda (forms) (compile-scheme-program interface forms)) source)))
        (display (stage compile-asm ir)))))
